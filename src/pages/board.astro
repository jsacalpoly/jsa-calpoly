---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

import aboutPhoto from "../assets/about/about-photo.jpg";
---

<BaseLayout title="About | Cal Poly JSA" description="About the Japanese Student Association at Cal Poly SLO.">
  <section class="about container">
    <div class="about-card">
      <div class="about-card__text">
        <h1 class="about-card__heading">ABOUT JSA</h1>
        <p>
          JSA is Cal Poly SLO's Japanese Student Association student club on campus. It operates as a non-profit social
          and cultural club, dedicated to sharing and celebrating Japanese culture in addition to fostering a JSA
          "family" community on campus. It's culture, community, &amp; chaos - what more could you want?
        </p>
        <p>
          JSA hosts weekly general meetings and weekend events, along with projects, intramural/recreational sports
          teams and weekly reserved study spaces! JSA also has a “big-little” program that pairs older members with new
          members, otherwise known as the “senpai-kouhai” program, used to create a closer-knit social circle! Some of
          our larger annual events include big-little revealing in the fall, winter formal, camping, and soubetsukai (a
          senior banquet) in the spring!
        </p>
        <p>JSA is open to everyone at Cal Poly!</p>
      </div>

      <div class="about-card__side">
        <div class="about-card__photo">
          <Image src={aboutPhoto} alt="JSA table sign decorated with origami and stickers" width={570} height={848} />
        </div>
        <a class="about-card__button" href="/contact">CONTACT US!</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding: 10px 0 0;
  }

  .about-card {
    display: flex;
    align-items: flex-start;
    height: 714px;
    border-radius: 30px;
    background: var(--color-coral);
    box-shadow: 0 0 7px rgba(0, 0, 0, 0.6);
  }

  .about-card__text {
    margin: 35.65px 0 0 61px;
    width: 464px;
    font-size: 17px;
    font-weight: var(--weight-light);
    line-height: 26px;
    color: #000;
  }

  .about-card__text p + p {
    margin-top: 26px;
  }

  .about-card__heading {
    margin-bottom: 29.05px;
    color: var(--color-white);
    font-size: 45px;
    font-weight: var(--weight-bold);
    line-height: 60.3px;
  }

  .about-card__side {
    margin: 98px 0 0 97px;
    width: 289px;
  }

  .about-card__photo {
    height: 428px;
    border: 2px solid var(--color-crimson);
    border-radius: 10px;
    background: var(--color-crimson);
    box-shadow: var(--shadow-frame);
    overflow: hidden;
  }

  .about-card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .about-card__button {
    margin-top: 67px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 26px;
    background: var(--color-red);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 14px;
  }
</style>
