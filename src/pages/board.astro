---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

import aboutPhoto from "../assets/about/about-photo.jpg";
import senpaiPhoto from "../assets/about/senpai-photo.jpg";

const facts = [
  { title: "Wednesdays, 7pm", text: "Weekly general meetings in Baker 107" },
  { title: "Weekend events", text: "Socials, outings, and everything in between" },
  { title: "Teams & study", text: "Intramural / rec sports and reserved study spaces" },
  { title: "Projects", text: "Cookbook, Torii, GenKey, and more" },
];

const year = [
  { season: "Fall", kanji: "秋", title: "Big-Little Reveal", text: "Kouhai finally find out who their senpai are." },
  { season: "Winter", kanji: "冬", title: "Winter Formal", text: "JSA's big dress-up night of the year." },
  {
    season: "Spring",
    kanji: "春",
    title: "Camping & Soubetsukai",
    text: "A camping trip, then a banquet to send off our seniors.",
  },
];
---

<BaseLayout
  title="About | Cal Poly JSA"
  description="About the Japanese Student Association at Cal Poly SLO."
  flushFooter
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__row container">
      <div class="hero__copy">
        <p class="eyebrow" data-reveal="up">
          <span class="eyebrow__rule"></span>
          <span class="eyebrow__label">Who we are</span>
          <span class="eyebrow__jp">私たちについて</span>
        </p>
        <h1 class="hero__title" data-reveal="up" style="--reveal-delay: 0.1s">
          About JSA
        </h1>
        <p class="hero__intro" data-reveal="up" style="--reveal-delay: 0.2s">
          JSA is Cal Poly SLO’s Japanese Student Association — a non-profit social and cultural club dedicated to
          sharing and celebrating Japanese culture, and to building a JSA “family” on campus. What more could you want?
        </p>
        <div class="hero__actions" data-reveal="up" style="--reveal-delay: 0.3s">
          <a class="button-outline" href="/contact">
            Contact us
          </a>
          <a class="text-link" href="https://www.instagram.com/calpolyjsa">
            Follow @calpolyjsa&nbsp;&nbsp;→
          </a>
        </div>
      </div>
      <div class="hero__photo" data-reveal style="--reveal-delay: 0.2s">
        <Image
          src={aboutPhoto}
          alt="JSA table sign decorated with origami and stickers"
          widths={[400, 800, 1200]}
          sizes="400px"
          quality={85}
        />
      </div>
    </div>
  </section>

  <!-- A year with JSA -->
  <section class="year">
    <div class="year__heading" data-reveal="up">
      <span class="year__jp">一年</span>
      <h2 class="year__title">A year with JSA</h2>
      <p class="year__subtitle">Some of our biggest annual events</p>
    </div>
    <div class="year__cards container">
      {year.map((item, i) => (
        <article class="season-card" data-reveal="up" style={`--reveal-delay: ${i * 0.12}s`}>
          <div class="season-card__top">
            <span class="season-card__season">{item.season}</span>
            <span class="season-card__kanji" aria-hidden="true">
              {item.kanji}
            </span>
          </div>
          <h3 class="season-card__title">{item.title}</h3>
          <p class="season-card__text">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Quick facts -->
  <section class="facts">
    <div class="facts__row container">
      {facts.map((fact, i) => (
        <div class="fact" data-reveal="up" style={`--reveal-delay: ${i * 0.08}s`}>
          <h3 class="fact__title">{fact.title}</h3>
          <p class="fact__text">{fact.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Senpai x Kouhai -->
  <section class="senpai">
    <div class="senpai__card container">
      <div class="senpai__photo" data-reveal>
        <Image
          src={senpaiPhoto}
          alt="JSA members posing together in their senpai-kouhai cords"
          widths={[420, 840]}
          sizes="420px"
          quality={85}
        />
      </div>
      <div class="senpai__copy" data-reveal="up" style="--reveal-delay: 0.15s">
        <p class="eyebrow">
          <span class="eyebrow__rule"></span>
          <span class="eyebrow__label">Big-little program</span>
          <span class="eyebrow__jp">先輩・後輩</span>
        </p>
        <h2 class="senpai__title">Find your senpai.</h2>
        <p class="senpai__text">
          Our “big-little” program — known as senpai-kouhai — pairs older members with new members to create a
          closer-knit social circle. It’s the heart of the JSA family.
        </p>
        <a class="button-solid" href="/senpai-kouhai-mentorship">
          Learn about Senpai × Kouhai&nbsp;&nbsp;→
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Shared bits ---------- */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
  }

  .eyebrow__rule {
    width: 32px;
    height: 2px;
    background: var(--color-maroon);
  }

  .eyebrow__label {
    color: var(--color-maroon);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow__jp {
    color: var(--color-text-muted);
    font-family: var(--font-serif-jp);
    font-weight: var(--weight-medium);
  }

  .button-outline,
  .button-solid {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .button-outline {
    padding: 17px 34px;
    border: 1.5px solid var(--color-ink);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .button-outline:hover,
  .button-outline:focus-visible {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .button-solid {
    padding: 13px 24px;
    background: var(--color-maroon);
    color: var(--color-white);
    font-size: 14px;
    font-weight: var(--weight-medium);
  }

  .button-solid:hover,
  .button-solid:focus-visible {
    background: var(--color-crimson);
  }

  .text-link {
    color: var(--color-maroon);
    font-size: 15px;
    font-weight: var(--weight-medium);
  }

  .text-link:hover,
  .text-link:focus-visible {
    text-decoration: underline;
  }

  /* ---------- Hero ---------- */
  .hero {
    padding: 88px 0 104px;
  }

  .hero__row {
    display: flex;
    align-items: center;
    gap: 80px;
  }

  .hero__copy {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 28px;
    width: 500px;
  }

  .hero__title {
    color: var(--color-ink);
    font-size: 56px;
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .hero__intro {
    color: var(--color-text-soft);
    font-size: 17px;
    font-weight: var(--weight-light);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .hero__photo {
    flex: none;
    width: 400px;
    height: 500px;
    border-radius: 28px;
    box-shadow: 0 16px 40px -8px rgba(0, 0, 0, 0.12);
    overflow: hidden;
  }

  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- A year with JSA ---------- */
  .year {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    padding: 104px 0 112px;
    background: var(--color-peach);
  }

  .year__heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .year__jp {
    color: var(--color-red);
    font-family: var(--font-serif-jp);
    font-size: 15px;
    font-weight: var(--weight-medium);
  }

  .year__title {
    color: var(--color-ink);
    font-size: 46px;
    font-weight: var(--weight-bold);
    letter-spacing: -0.01em;
    line-height: 1.5;
  }

  .year__subtitle {
    color: var(--color-text-muted);
    font-size: 17px;
    font-weight: var(--weight-light);
  }

  .year__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .season-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 30px 32px 36px;
    border-radius: 22px;
    background: var(--color-white);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .season-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 63px;
  }

  .season-card__season {
    color: var(--color-red);
    font-size: 13px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .season-card__kanji {
    color: var(--color-kanji);
    font-family: var(--font-serif-jp);
    font-size: 44px;
    font-weight: var(--weight-bold);
  }

  .season-card__title {
    color: var(--color-ink);
    font-size: 23px;
    font-weight: var(--weight-semibold);
    line-height: 1.25;
  }

  .season-card__text {
    color: var(--color-text-muted);
    font-size: 15px;
    font-weight: var(--weight-light);
    line-height: 1.55;
  }

  /* ---------- Quick facts ---------- */
  .facts {
    padding: 44px 0;
    border-block: 1px solid var(--color-divider);
  }

  .facts__row {
    display: flex;
    gap: 48px;
  }

  .fact {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 8px;
  }

  .fact__title {
    color: var(--color-ink);
    font-size: 18px;
    font-weight: var(--weight-medium);
  }

  .fact__text {
    color: var(--color-text-muted);
    font-size: 14px;
    font-weight: var(--weight-light);
    line-height: 1.5;
  }

  /* ---------- Senpai x Kouhai ---------- */
  .senpai {
    padding: 96px 0;
  }

  .senpai__card {
    display: flex;
    align-items: center;
    gap: 56px;
    padding: 40px;
    border-radius: 32px;
    background: var(--color-peach);
  }

  .senpai__photo {
    flex: none;
    width: 420px;
    height: 340px;
    border-radius: 24px;
    overflow: hidden;
  }

  .senpai__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .senpai__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    min-width: 0;
  }

  .senpai__title {
    color: var(--color-ink);
    font-size: 40px;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .senpai__text {
    color: var(--color-text-soft);
    font-size: 16px;
    font-weight: var(--weight-light);
    line-height: 1.65;
  }
</style>
