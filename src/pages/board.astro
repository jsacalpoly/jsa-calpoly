---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

import aboutPhoto from "../assets/about/about-photo.jpg";
import senpaiPhoto from "../assets/about/senpai-photo.jpg";

const year = [
  { season: "Fall", kanji: "秋", title: "Big-Little Reveal", text: "Kouhai finally find out who their senpai are." },
  { season: "Winter", kanji: "冬", title: "Winter Formal", text: "JSA's big dress-up night of the year." },
  {
    season: "Spring",
    kanji: "春",
    title: "Camping & Soubetsukai",
    text: "A camping trip, then a banquet to send off our seniors.",
  },
];
---

<BaseLayout
  title="About | Cal Poly JSA"
  description="About the Japanese Student Association at Cal Poly SLO."
  flushFooter
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__row container">
      <div class="hero__copy">
        <p class="eyebrow">
          <span class="eyebrow__rule"></span>
          <span class="eyebrow__label">Who we are</span>
          <span class="eyebrow__jp">私たちについて</span>
        </p>
        <h1 class="hero__title" data-reveal="up">
          About JSA
        </h1>
        <p class="hero__intro" data-reveal="up" style="--reveal-delay: 0.08s">
          JSA is Cal Poly SLO’s Japanese Student Association — a social and cultural club dedicated to sharing Japanese
          culture, and most importantly, building a JSA “family” on campus. Our main goal is to make everyone feel at
          home and have fun!!!
        </p>
      </div>
      <div class="hero__photo" data-reveal style="--reveal-delay: 0.1s">
        <Image
          src={aboutPhoto}
          alt="JSA table sign decorated with origami and stickers"
          widths={[340, 680, 1020]}
          sizes="340px"
          quality={85}
        />
      </div>
    </div>
  </section>

  <!-- A year with JSA -->
  <section class="year">
    <div class="year__heading" data-reveal="up">
      <span class="year__jp">一年</span>
      <h2 class="year__title">A year with JSA</h2>
      <p class="year__subtitle">Some of our biggest annual events</p>
    </div>
    <div class="year__cards container">
      {year.map((item, i) => (
        <article class="season-card" data-reveal="up" style={`--reveal-delay: ${i * 0.08}s`}>
          <div class="season-card__top">
            <span class="season-card__season">{item.season}</span>
            <span class="season-card__kanji" aria-hidden="true">
              {item.kanji}
            </span>
          </div>
          <h3 class="season-card__title">{item.title}</h3>
          <p class="season-card__text">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Senpai x Kouhai -->
  <section class="senpai">
    <div class="senpai__card container">
      <div class="senpai__photo" data-reveal>
        <Image
          src={senpaiPhoto}
          alt="JSA members posing together in their senpai-kouhai cords"
          widths={[380, 760]}
          sizes="380px"
          quality={85}
        />
      </div>
      <div class="senpai__copy" data-reveal="up" style="--reveal-delay: 0.1s">
        <p class="eyebrow">
          <span class="eyebrow__rule"></span>
          <span class="eyebrow__label">Big-little program</span>
          <span class="eyebrow__jp">先輩・後輩</span>
        </p>
        <h2 class="senpai__title">Find your senpai.</h2>
        <p class="senpai__text">
          Our “big-little” program — known as senpai-kouhai — pairs older members with new members to create a
          closer-knit social circle. It’s the heart of the JSA family.
        </p>
        <a class="button-solid" aria-disabled="true">
          Learn about Senpai × Kouhai&nbsp;&nbsp;→
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Shared bits ---------- */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
  }

  .eyebrow__rule {
    width: 32px;
    height: 2px;
    background: var(--color-maroon);
  }

  .eyebrow__label {
    color: var(--color-maroon);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow__jp {
    color: var(--color-text-muted);
    font-family: var(--font-serif-jp);
    font-weight: var(--weight-medium);
  }

  .button-solid {
    display: inline-flex;
    align-items: center;
    padding: 13px 24px;
    border-radius: 999px;
    background: var(--color-maroon);
    color: var(--color-white);
    font-size: 14px;
    font-weight: var(--weight-medium);
    transition: background-color 0.2s ease;
  }

  .button-solid:hover,
  .button-solid:focus-visible {
    background: var(--color-crimson);
  }

  /* ---------- Hero ---------- */
  .hero {
    padding: 56px 0;
  }

  .hero__row {
    display: flex;
    align-items: center;
    gap: 80px;
  }

  .hero__copy {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 22px;
    width: 560px;
  }

  .hero__title {
    color: var(--color-ink);
    font-size: 56px;
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .hero__intro {
    color: var(--color-text-soft);
    font-size: 17px;
    font-weight: var(--weight-light);
    line-height: 1.65;
  }

  .hero__photo {
    flex: none;
    width: 340px;
    height: 400px;
    border-radius: 28px;
    box-shadow: 0 16px 40px -8px rgba(0, 0, 0, 0.12);
    overflow: hidden;
  }

  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- A year with JSA ---------- */
  .year {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding: 64px 0 72px;
    background: var(--color-peach);
  }

  .year__heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .year__jp {
    color: var(--color-red);
    font-family: var(--font-serif-jp);
    font-size: 15px;
    font-weight: var(--weight-medium);
  }

  .year__title {
    color: var(--color-ink);
    font-size: 46px;
    font-weight: var(--weight-bold);
    letter-spacing: -0.01em;
    line-height: 1.5;
  }

  .year__subtitle {
    color: var(--color-text-muted);
    font-size: 17px;
    font-weight: var(--weight-light);
  }

  .year__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .season-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 28px 28px;
    border-radius: 22px;
    background: var(--color-white);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .season-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 49px;
  }

  .season-card__season {
    color: var(--color-red);
    font-size: 13px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .season-card__kanji {
    color: var(--color-kanji);
    font-family: var(--font-serif-jp);
    font-size: 34px;
    font-weight: var(--weight-bold);
  }

  .season-card__title {
    color: var(--color-ink);
    font-size: 21px;
    font-weight: var(--weight-semibold);
    line-height: 1.25;
  }

  .season-card__text {
    color: var(--color-text-muted);
    font-size: 14px;
    font-weight: var(--weight-light);
    line-height: 1.55;
  }

  /* ---------- Senpai x Kouhai ---------- */
  .senpai {
    padding: 56px 0 64px;
  }

  .senpai__card {
    display: flex;
    align-items: center;
    gap: 48px;
    padding: 32px;
    border-radius: 32px;
    background: var(--color-peach);
  }

  .senpai__photo {
    flex: none;
    width: 380px;
    height: 300px;
    border-radius: 24px;
    overflow: hidden;
  }

  .senpai__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .senpai__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    min-width: 0;
  }

  .senpai__title {
    color: var(--color-ink);
    font-size: 34px;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .senpai__text {
    color: var(--color-text-soft);
    font-size: 16px;
    font-weight: var(--weight-light);
    line-height: 1.65;
  }
</style>
