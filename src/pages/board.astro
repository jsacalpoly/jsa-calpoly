---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

import aboutPhoto from "../assets/about/about-photo.jpg";

const year = [
  { season: "Fall", kanji: "秋", title: "Big-Little Reveal", text: "Kouhai finally find out who their senpai are." },
  { season: "Winter", kanji: "冬", title: "Winter Formal", text: "JSA's big dress-up night of the year." },
  {
    season: "Spring",
    kanji: "春",
    title: "Camping & Soubetsukai",
    text: "A camping trip, then a banquet to send off our seniors.",
  },
];

// What keeps going between the big days.
const allYear = [
  {
    title: "General meetings",
    when: "Wednesdays · 7 PM · Baker 107",
    text: "Drop in any week to hang out and meet people.",
    bar: "var(--color-red)",
  },
  {
    title: "Projects",
    when: "All year",
    text: "Torii, ゲンKEY, Kazuma Daiko, Cookbook, Matcha Run, and more.",
    bar: "var(--color-orange)",
  },
  {
    title: "Sports",
    when: "Weekly",
    text: "Volleyball almost every semester, plus basketball, softball, and futsal.",
    bar: "var(--color-pink)",
  },
];
---

<BaseLayout
  title="About | Cal Poly JSA"
  description="About the Japanese Student Association at Cal Poly SLO."
  flushFooter
  responsive
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__row container">
      <div class="hero__copy">
        <p class="eyebrow">
          <span class="eyebrow__rule"></span>
          <span class="eyebrow__label">Who we are</span>
          <span class="eyebrow__jp">私たちについて</span>
        </p>
        <h1 class="hero__title" data-reveal="up">
          About JSA
        </h1>
        <p class="hero__intro" data-reveal="up" style="--reveal-delay: 0.08s">
          JSA is Cal Poly SLO’s Japanese Student Association — a social and cultural club dedicated to sharing Japanese
          culture, and most importantly, building a JSA “family” on campus. Our main goal is to make everyone feel at
          home and have fun!!!
        </p>
      </div>
      <div class="hero__photo" data-reveal style="--reveal-delay: 0.1s">
        <Image
          src={aboutPhoto}
          alt="JSA table sign decorated with origami and stickers"
          widths={[340, 680, 1020]}
          sizes="340px"
          quality={85}
        />
      </div>
    </div>
  </section>

  <!-- A year with JSA -->
  <section class="year">
    <div class="year__heading" data-reveal="up">
      <span class="year__jp">一年</span>
      <h2 class="year__title">A year with JSA</h2>
      <p class="year__subtitle">Some of our biggest annual events</p>
    </div>
    <div class="year__cards container">
      <div class="year__track">
        {year.map((item, i) => (
          <article class="season-card" data-reveal="up" style={`--reveal-delay: ${i * 0.08}s`}>
            <div class="season-card__top">
              <span class="season-card__season">{item.season}</span>
              <span class="season-card__kanji" aria-hidden="true">
                {item.kanji}
              </span>
            </div>
            <h3 class="season-card__title">{item.title}</h3>
            <p class="season-card__text">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
    <!-- Phone only: the belt the cards ride on, and which card is showing. -->
    <div class="year__rail" aria-hidden="true"></div>
    <div class="year__dots" aria-hidden="true">
      {year.map((_, i) => (
        <span class:list={{ "is-active": i === 0 }} />
      ))}
    </div>
    <p class="year__hint">Slides on its own · swipe to take over</p>
  </section>

  <!-- All year long: what keeps going between the big days -->
  <section class="allyear">
    <div class="allyear__heading" data-reveal="up">
      <h2 class="allyear__title">All year long</h2>
      <p class="allyear__subtitle">
        Between the big days, there’s always something going on, and you’re always free to pull up.
      </p>
    </div>
    <div class="allyear__columns container">
      {allYear.map((item, i) => (
        <div class="allyear__column" data-reveal="up" style={`--reveal-delay: ${i * 0.08}s; --bar: ${item.bar}`}>
          <h3 class="allyear__name">{item.title}</h3>
          <p class="allyear__when">{item.when}</p>
          <p class="allyear__text">{item.text}</p>
        </div>
      ))}
    </div>
    <div class="allyear__cta" data-reveal="up">
      <p class="allyear__hand">find your thing</p>
      <a class="allyear__button" href="/projects">
        See all projects →
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // Phones: "A year with JSA" is a conveyor belt that glides along at a steady speed and loops forever.
  // Touch and drag to take over; it carries on once you let go.
  const phone = window.matchMedia("(max-width: 768px)");
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
  const viewport = document.querySelector<HTMLElement>(".year__cards");
  const track = document.querySelector<HTMLElement>(".year__track");
  const dots = document.querySelectorAll<HTMLElement>(".year__dots span");

  const CARD = 300;
  const STEP = CARD + 16; // card width plus the gap
  const SPEED = 34; // px per second
  const RESUME = 1200; // ms the belt waits after a touch

  if (viewport && track) {
    const originals = Array.from(track.children) as HTMLElement[];
    originals.forEach((card, i) => (card.dataset.index = String(i)));
    let running = false;
    let frame = 0;
    let last = 0;
    let offset = 0; // how far the belt has moved past its starting spot, 0 to STEP
    let holdUntil = 0;
    let dragging = false;
    let dragFrom = 0;
    let dragStart = 0;

    // Move the first card to the back (or the last to the front) so the belt never runs out.
    const wrap = () => {
      while (offset >= STEP) {
        track.append(track.firstElementChild as Element);
        offset -= STEP;
      }
      while (offset < 0) {
        track.prepend(track.lastElementChild as Element);
        offset += STEP;
      }
    };

    // Draw one frame: slide the track, fade each card by how far it is from the middle, and light the right dot.
    const draw = () => {
      track.style.transform = `translateX(${-offset}px)`;
      const middle = viewport.clientWidth / 2;
      const left = (viewport.clientWidth - CARD) / 2;
      let nearest: HTMLElement | null = null;
      let best = Infinity;
      Array.from(track.children).forEach((child, i) => {
        const card = child as HTMLElement;
        const distance = Math.abs(left + i * STEP + CARD / 2 - offset - middle);
        card.style.opacity = String(1 - 0.45 * Math.min(1, distance / STEP));
        if (distance < best) {
          best = distance;
          nearest = card;
        }
      });
      const index = Number((nearest as HTMLElement | null)?.dataset.index ?? 0);
      dots.forEach((dot, i) => dot.classList.toggle("is-active", i === index));
    };

    const tick = (time: number) => {
      const dt = Math.min(time - last, 50) / 1000;
      last = time;
      if (!dragging && !calm.matches && time > holdUntil && !document.hidden) offset += SPEED * dt;
      wrap();
      draw();
      frame = requestAnimationFrame(tick);
    };

    const start = () => {
      if (running) return;
      running = true;
      track.style.paddingLeft = `${(viewport.clientWidth - CARD) / 2}px`;
      last = performance.now();
      frame = requestAnimationFrame(tick);
    };

    const stop = () => {
      if (!running) return;
      running = false;
      cancelAnimationFrame(frame);
      originals.forEach((card) => {
        track.append(card);
        card.style.opacity = "";
      });
      track.style.transform = "";
      track.style.paddingLeft = "";
      offset = 0;
    };

    // Dragging moves the belt with the finger.
    viewport.addEventListener(
      "touchstart",
      (event) => {
        if (!running) return;
        dragging = true;
        dragStart = event.touches[0].clientX;
        dragFrom = offset;
      },
      { passive: true },
    );
    viewport.addEventListener(
      "touchmove",
      (event) => {
        if (!dragging) return;
        offset = dragFrom - (event.touches[0].clientX - dragStart);
        wrap();
        dragFrom = offset + (event.touches[0].clientX - dragStart);
      },
      { passive: true },
    );
    const release = () => {
      dragging = false;
      holdUntil = performance.now() + RESUME;
    };
    viewport.addEventListener("touchend", release);
    viewport.addEventListener("touchcancel", release);

    const sync = () => (phone.matches ? start() : stop());
    sync();
    phone.addEventListener("change", sync);
    window.addEventListener("resize", () => {
      if (running) track.style.paddingLeft = `${(viewport.clientWidth - CARD) / 2}px`;
    });
  }
</script>

<style>
  /* ---------- Shared bits ---------- */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
  }

  .eyebrow__rule {
    width: 32px;
    height: 2px;
    background: var(--color-maroon);
  }

  .eyebrow__label {
    color: var(--color-maroon);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow__jp {
    color: var(--color-text-muted);
    font-family: var(--font-serif-jp);
    font-weight: var(--weight-medium);
  }

  /* ---------- Hero ---------- */
  .hero {
    padding: 56px 0;
  }

  .hero__row {
    display: flex;
    align-items: center;
    gap: 80px;
  }

  .hero__copy {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 22px;
    width: 560px;
  }

  .hero__title {
    color: var(--color-ink);
    font-size: 56px;
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .hero__intro {
    color: var(--color-text-soft);
    font-size: 17px;
    font-weight: var(--weight-light);
    line-height: 1.65;
  }

  .hero__photo {
    flex: none;
    width: 340px;
    height: 400px;
    border-radius: 28px;
    box-shadow: 0 16px 40px -8px rgba(0, 0, 0, 0.12);
    overflow: hidden;
  }

  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- A year with JSA ---------- */
  .year {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding: 64px 0 72px;
    background: var(--color-peach);
  }

  .year__heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .year__jp {
    color: var(--color-red);
    font-family: var(--font-serif-jp);
    font-size: 15px;
    font-weight: var(--weight-medium);
  }

  .year__title {
    color: var(--color-ink);
    font-size: 46px;
    font-weight: var(--weight-bold);
    letter-spacing: -0.01em;
    line-height: 1.5;
  }

  .year__subtitle {
    color: var(--color-text-muted);
    font-size: 17px;
    font-weight: var(--weight-light);
  }

  .year__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .season-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 28px 28px;
    border-radius: 22px;
    background: var(--color-white);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .season-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 49px;
  }

  .season-card__season {
    color: var(--color-red);
    font-size: 13px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .season-card__kanji {
    color: var(--color-kanji);
    font-family: var(--font-serif-jp);
    font-size: 34px;
    font-weight: var(--weight-bold);
  }

  .season-card__title {
    color: var(--color-ink);
    font-size: 21px;
    font-weight: var(--weight-semibold);
    line-height: 1.25;
  }

  .season-card__text {
    color: var(--color-text-muted);
    font-size: 14px;
    font-weight: var(--weight-light);
    line-height: 1.55;
  }

  /* ---------- All year long ---------- */
  .allyear {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
    padding: 100px 0 120px;
  }

  .allyear__heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }

  .allyear__title {
    color: var(--color-ink);
    font-size: 40px;
    font-weight: var(--weight-bold);
    line-height: 1.2;
  }

  .allyear__subtitle {
    color: var(--color-text-soft);
    font-size: 17px;
    font-weight: var(--weight-light);
  }

  .allyear__columns {
    display: flex;
    justify-content: center;
    gap: 56px;
  }

  .allyear__column {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    max-width: 290px;
  }

  /* A short bar in the column's color. */
  .allyear__column::before {
    content: "";
    width: 44px;
    height: 4px;
    border-radius: 2px;
    background: var(--bar);
  }

  .allyear__name {
    color: var(--color-ink);
    font-size: 24px;
    font-weight: var(--weight-semibold);
    line-height: 1.2;
  }

  .allyear__when {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .allyear__text {
    color: var(--color-text-soft);
    font-size: 16px;
    font-weight: var(--weight-light);
    line-height: 25px;
  }

  .allyear__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .allyear__hand {
    color: var(--color-red);
    font-family: var(--font-hand);
    font-size: 46px;
    font-weight: var(--weight-bold);
    line-height: 1;
  }

  /* The same coral pill as the home page button. */
  .allyear__button {
    display: inline-flex;
    align-items: center;
    padding: 15px 34px;
    border-radius: 999px;
    background: var(--color-coral);
    color: var(--color-white);
    font-family: var(--font-jp);
    font-size: 15px;
    font-weight: var(--weight-bold);
    transition: background-color 0.4s ease;
  }

  .allyear__button:hover,
  .allyear__button:focus-visible {
    background: var(--color-red);
  }

  /* The belt, dots and hint only exist on phones. */
  .year__track {
    display: contents;
  }

  .year__rail,
  .year__dots,
  .year__hint {
    display: none;
  }

  /* ---------- Phone ---------- */
  @media (max-width: 768px) {
    .eyebrow {
      gap: 10px;
      font-size: 12px;
    }

    .eyebrow__rule {
      width: 28px;
    }

    /* Hero: eyebrow, then the title beside a small tilted photo, then the intro. */
    .hero {
      padding: 32px 24px 36px;
    }

    .hero__row {
      display: grid;
      grid-template-columns: 1fr 112px;
      gap: 18px 14px;
      align-items: center;
      width: auto;
    }

    .hero__copy {
      display: contents;
    }

    .hero__copy .eyebrow {
      grid-area: 1 / 1 / 2 / 3;
    }

    .hero__title {
      grid-area: 2 / 1 / 3 / 2;
      font-size: 38px;
      line-height: 48px;
    }

    .hero__photo {
      grid-area: 2 / 2 / 3 / 3;
      width: 112px;
      height: 140px;
      border-radius: 18px;
      box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.12);
      rotate: -4deg;
    }

    .hero__intro {
      grid-area: 3 / 1 / 4 / 3;
      font-size: 15px;
      line-height: 26px;
    }

    /* A year with JSA: a one-card conveyor belt. */
    .year {
      gap: 20px;
      padding: 40px 0 44px;
    }

    .year__heading {
      gap: 8px;
      padding-inline: 24px;
      text-align: center;
    }

    .year__jp {
      font-size: 14px;
    }

    .year__title {
      font-size: 32px;
      line-height: 40px;
    }

    .year__subtitle {
      font-size: 15px;
    }

    /* The window the cards ride through: the current card sits in the middle, its neighbours peek in at the edges. */
    .year__cards {
      width: 100%;
      margin: 0;
      padding: 10px 0 26px;
      margin-bottom: -20px;
      overflow: hidden;
    }

    .year__track {
      display: flex;
      gap: 16px;
      touch-action: pan-y;
      will-change: transform;
    }

    .season-card {
      flex: none;
      gap: 8px;
      width: 300px;
      min-height: 176px;
      padding: 20px 24px 24px;
    }

    /* The belt sets each card's fade as it moves; the entrance fade must not hide the ones peeking in. */
    :global(.js) .year__cards .season-card[data-reveal] {
      opacity: 0.55;
      animation: none;
    }

    .season-card__top {
      height: 49px;
    }

    .season-card__season {
      font-size: 12px;
    }

    .season-card__title {
      font-size: 20px;
      line-height: 25px;
    }

    .season-card__text {
      line-height: 21px;
    }

    /* The belt itself: a dashed strip, with dots for the current card. */
    .year__rail {
      display: block;
      align-self: stretch;
      height: 8px;
      margin-inline: 24px;
      border: 1.5px dashed rgba(237, 69, 69, 0.5);
      border-radius: 4px;
      background-color: rgba(237, 69, 69, 0.14);
    }

    .year__dots {
      display: flex;
      gap: 10px;
      justify-content: center;
    }

    .year__dots span {
      width: 7px;
      height: 7px;
      border-radius: 4px;
      background: rgba(237, 69, 69, 0.28);
      transition:
        width 0.3s ease,
        background-color 0.3s ease;
    }

    .year__dots span.is-active {
      width: 20px;
      background: var(--color-red);
    }

    .year__hint {
      display: block;
      color: var(--color-text-muted);
      font-size: 12px;
      font-weight: var(--weight-light);
      text-align: center;
    }

    /* All year long: the three columns stack. */
    .allyear {
      gap: 36px;
      padding: 64px 24px 72px;
    }

    .allyear__title {
      font-size: 30px;
    }

    .allyear__subtitle {
      max-width: 300px;
      font-size: 15px;
      line-height: 23px;
    }

    .allyear__columns {
      flex-direction: column;
      gap: 28px;
      width: 310px;
    }

    .allyear__column {
      flex: none;
      max-width: none;
      gap: 8px;
    }

    .allyear__name {
      font-size: 22px;
    }

    .allyear__when {
      font-size: 12px;
    }

    .allyear__text {
      font-size: 15px;
      line-height: 23px;
    }

    .allyear__cta {
      gap: 14px;
    }

    .allyear__hand {
      font-size: 40px;
    }

    .allyear__button {
      padding: 14px 32px;
    }
  }
</style>
