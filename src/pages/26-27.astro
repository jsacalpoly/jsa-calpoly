---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BoardCard from "../components/BoardCard.astro";

import banner from "../assets/board/banner-meet-jsa.jpg";
import blossomsLeft from "../assets/board/blossoms-left.png";
import blossomsRight from "../assets/board/blossoms-right.png";
import flowerDivider from "../assets/board/flower-divider.png";

const board = await getEntry("boards", "2026-2027");
if (!board) throw new Error("Missing board data: src/content/boards/2026-2027.json");

const executives = board.data.members.filter((member) => member.tier === "executive");
const members = board.data.members.filter((member) => member.tier === "member");

// Board member rows of four, as laid out on the Wix site.
const memberRows = [];
for (let i = 0; i < members.length; i += 4) memberRows.push(members.slice(i, i + 4));
---

<BaseLayout title="26-27 | Cal Poly JSA" description="Meet the 2026-2027 Cal Poly JSA board." responsive>
  <div class="board-wrap">
    <div class="board container">
      <div class="board__banner" data-reveal>
        <Image src={banner} alt="Meet JSA: the 2026-27 board posing together" width={1882} height={1048} />
      </div>

      <Image class="board__blossoms board__blossoms--left" src={blossomsLeft} alt="" width={238} height={212} />
      <Image class="board__blossoms board__blossoms--right" src={blossomsRight} alt="" width={458} height={305} />

      <h1 class="board__title" data-reveal="up">
        OUR BOARD
      </h1>
      <Image class="board__flower" src={flowerDivider} alt="" width={34} height={34} />
      <p class="board__subtitle">Meet the leaders behind JSA</p>
      <p class="board__hint">Tap a card to learn more</p>

      <div class="divider divider--executive">
        <span class="divider__line" data-reveal="line" style="--reveal-delay: 0.1s"></span>
        <h2 class="divider__text">EXECUTIVE</h2>
        <span class="divider__line" data-reveal="line" style="--reveal-delay: 0.1s"></span>
      </div>

      <div class="board__executives">
        {executives.map((member, i) => (
          <BoardCard variant="executive" featured={member.role === "President"} {...member} delay={i * 0.08} />
        ))}
      </div>

      <div class="divider divider--members">
        <span class="divider__line" data-reveal="line" style="--reveal-delay: 0.1s"></span>
        <h2 class="divider__text">Board Members</h2>
        <span class="divider__line" data-reveal="line" style="--reveal-delay: 0.1s"></span>
      </div>

      <div class="board__member-grid">
        {memberRows.map((row, index) => (
          <div class:list={["board__members", `board__members--row${index + 1}`]}>
            {row.map((member, i) => (
              <BoardCard {...member} delay={i * 0.06} />
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Phones: a tap fades a card to its About panel (desktop uses hover). Tap it again, tap elsewhere, or press Escape to close.
  const phone = window.matchMedia("(max-width: 768px)");
  const cards = document.querySelectorAll<HTMLElement>(".board-card[tabindex]");

  function setOpen(card: HTMLElement, open: boolean) {
    card.classList.toggle("is-open", open);
    card.setAttribute("aria-expanded", String(open));
  }

  function closeAll(except?: HTMLElement) {
    cards.forEach((card) => card !== except && card.classList.contains("is-open") && setOpen(card, false));
  }

  function toggle(card: HTMLElement) {
    closeAll(card);
    setOpen(card, !card.classList.contains("is-open"));
  }

  cards.forEach((card) => {
    card.setAttribute("aria-expanded", "false");
    card.addEventListener("click", (event) => {
      if (!phone.matches) return;
      event.stopPropagation();
      toggle(card);
    });
    card.addEventListener("keydown", (event) => {
      if (!phone.matches || (event.key !== "Enter" && event.key !== " ")) return;
      event.preventDefault();
      toggle(card);
    });
  });

  document.addEventListener("click", () => closeAll());
  document.addEventListener("keydown", (event) => event.key === "Escape" && closeAll());
  phone.addEventListener("change", () => closeAll());
</script>

<style>
  /* The cream backdrop runs the full width of the screen; the content stays in the 980px column. */
  .board-wrap {
    background: var(--color-cream);
  }

  /* The column is 1659.3px tall (79 to 1738.3) and leaves a 20px gap above the footer. */
  .board {
    height: 1659.3px;
    padding-top: 10px;
  }

  .board__banner {
    margin-left: 17px;
    width: 945px;
    height: 528px;
    border: 2px solid var(--color-white);
    border-radius: 15px;
    background: var(--color-white);
    box-shadow: var(--shadow-frame);
    overflow: hidden;
  }

  .board__banner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 13px;
  }

  .board__blossoms {
    position: absolute;
    pointer-events: none;
  }

  .board__blossoms--left {
    left: 0;
    top: 519px;
    width: 238px;
    height: 212px;
  }

  .board__blossoms--right {
    left: 522px;
    top: 482px;
    width: 458px;
    height: 305px;
  }

  .board__title {
    position: relative;
    margin-top: 0.8px;
    color: var(--color-red);
    font-size: 60px;
    font-weight: var(--weight-semibold);
    line-height: 84.6px;
    text-align: center;
  }

  .board__flower {
    position: relative;
    margin: -5.8px auto 0;
    left: -1px;
    width: 34px;
    height: 34px;
  }

  .board__subtitle {
    position: relative;
    margin-top: 7.6px;
    font-size: 13px;
    font-weight: var(--weight-extralight);
    line-height: 18.2px;
    text-align: center;
    color: #000;
  }

  /* Heading flanked by thin rules. Widths and gaps come straight from Figma. */
  .divider {
    position: relative;
    display: grid;
    align-items: start;
    margin-top: 5.9px;
    height: 25.4px;
  }

  .divider--executive {
    grid-template-columns: 312px 1fr 319px;
    margin-left: 111px;
    width: 760px;
  }

  .divider--members {
    margin-top: 28px;
    grid-template-columns: 279px 1fr 279px;
    margin-left: 111px;
    width: 760px;
  }

  .divider__line {
    height: 1px;
    margin-top: 12.3px;
    background: var(--color-line);
  }

  .divider--members .divider__line {
    margin-top: 17.7px;
  }

  .divider__text {
    padding-left: 19px;
    font-size: 18px;
    font-weight: var(--weight-semibold);
    line-height: 25.4px;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .divider--members .divider__text {
    padding-left: 27px;
  }

  .board__executives {
    position: relative;
    margin: 9.3px 0 0 109px;
    display: flex;
    gap: 14px;
  }

  .board__members {
    position: relative;
    display: flex;
    gap: 23px;
    margin-left: 51px;
  }

  .board__members--row1 {
    margin-top: 8.3px;
  }

  .board__members--row2 {
    margin-top: 32px;
  }

  .board__members--row3 {
    margin-top: 45.4px;
  }

  /* The hint and the grid wrapper only matter on phones. */
  .board__hint {
    display: none;
  }

  .board__member-grid {
    display: contents;
  }

  /* ---------- Phone: one column, cream backdrop, the president on top ---------- */
  @media (max-width: 768px) {
    .board {
      width: auto;
      height: auto;
      padding: 14px 24px 44px;
    }

    .board__banner {
      margin: 0;
      width: auto;
      height: auto;
      aspect-ratio: 945 / 528;
    }

    /* Blossom branches overlap the lower corners of the banner (banner height = (screen - 48px) x 528 / 945). */
    .board__blossoms--left {
      left: 0;
      top: calc(14px + (100vw - 48px) * 0.5587 - 34px);
      width: 104px;
      height: 93px;
    }

    .board__blossoms--right {
      left: auto;
      right: 0;
      top: calc(14px + (100vw - 48px) * 0.5587 - 52px);
      width: 186px;
      height: 124px;
    }

    .board__title {
      margin-top: 18px;
      font-size: 40px;
      line-height: 48px;
    }

    .board__flower {
      width: 30px;
      height: 30px;
      margin: 2px auto 0;
      left: 0;
    }

    .board__subtitle {
      margin-top: 2px;
    }

    .board__hint {
      position: relative;
      display: block;
      margin-top: 2px;
      color: #787878;
      font-size: 11px;
      font-weight: var(--weight-light);
      line-height: 16px;
      text-align: center;
    }

    .divider,
    .divider--executive,
    .divider--members {
      display: flex;
      align-items: center;
      gap: 12px;
      width: auto;
      height: auto;
      margin: 22px 0 12px;
    }

    .divider--members {
      margin-top: 28px;
      margin-bottom: 14px;
    }

    .divider__line,
    .divider--members .divider__line {
      flex: 1;
      margin: 0;
    }

    .divider__text,
    .divider--members .divider__text {
      padding: 0;
      font-size: 16px;
      line-height: 24px;
    }

    /* Executives: the president alone on top, the other two side by side. */
    .board__executives {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin: 0;
    }

    .board__executives > :global(.board-card--featured) {
      grid-column: 1 / -1;
      justify-self: center;
      order: -1;
      width: 170px;
    }

    /* Board members: three across; the rows of four melt into one grid. */
    .board__member-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 9px;
    }

    .board__members,
    .board__members--row1,
    .board__members--row2,
    .board__members--row3 {
      display: contents;
      margin: 0;
    }
  }
</style>
