      padding-left: 14px;
      border-left: 2px dotted var(--color-red);
    }

    .story__note-label {
      color: var(--color-red);
      font-size: 12px;
      font-weight: var(--weight-semibold);
      letter-spacing: 0.04em;
    }

    .story__note p:not(.story__note-label) {
      font-size: 14px;
      line-height: 22px;
    }
  }

  /* ---------- Projects ---------- */
  .projects {
    padding: 90px 80px 100px;
    background: var(--color-white);
  }

  .projects__title {
    color: var(--color-red);
    font-size: 60px;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
    line-height: 1.05;
    text-align: center;
  }

  /* The photos stick out above the papers, so leave room for them under the title. */
  .projects__cards {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 32px;
    margin-top: 70px;
  }

  .projects__dots {
    display: none;
  }

  /* Phone: a heading, then the three papers in a row you swipe, with dots underneath. */
  @media (max-width: 768px) {
    .projects {
      padding: 72px 0 80px;
    }

    .projects__title {
      font-size: 36px;
      line-height: 38px;
    }

    /* Extra top and bottom room so the taped photos and the shadows are not cut off by the scroll area. */
    .projects__cards {
      justify-content: flex-start;
      gap: 16px;
      margin-top: 20px;
      padding: 16px 24px 20px;
      overflow-x: auto;
      scroll-padding-inline: 24px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .projects__cards::-webkit-scrollbar {
      display: none;
    }

    .projects__cards > :global(*) {
      scroll-snap-align: start;
    }

    .projects__dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 16px;
    }

    .projects__dots span {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #d9d9d9;
      transition: background-color 0.2s ease;
    }

    .projects__dots span.is-active {
      background: var(--color-red);
    }
  }
</style>

<script>
  // Phones: light up the dot for the project card that is in view.
  const cards = document.querySelector<HTMLElement>(".projects__cards");
  const dotEls = document.querySelectorAll<HTMLElement>(".projects__dots span");

  cards?.addEventListener(
    "scroll",
    () => {
      const first = cards.firstElementChild as HTMLElement | null;
      if (!first) return;
      const step = first.offsetWidth + parseFloat(getComputedStyle(cards).columnGap || "0");
      const active = Math.min(dotEls.length - 1, Math.max(0, Math.round(cards.scrollLeft / step)));
      dotEls.forEach((dot, i) => dot.classList.toggle("is-active", i === active));
    },
    { passive: true },
  );
</script>
