---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

import hero from "../assets/home/hero.jpg";
import heroArrowLeft from "../assets/home/hero-arrow-left.png";
import heroArrowRight from "../assets/home/hero-arrow-right.png";
import welcome from "../assets/home/welcome.jpg";
import join from "../assets/home/join.jpg";
import events from "../assets/home/events.jpg";
import cookbook from "../assets/projects/cookbook.png";
import torii from "../assets/projects/torii.jpg";
import genkey from "../assets/projects/genkey.jpg";

// TODO: move into src/content/projects once the Projects page is built.
const projects = [
  {
    title: "Cookbook",
    description:
      "Recipes, cooking events, and more! Cookbook welcomes everyone who loves to cook (or eat)! Keep up with the GroupMe to see when we meet!",
    image: cookbook,
    color: "var(--color-coral)",
    height: 584,
  },
  {
    title: "Torii",
    description:
      "We're building a life size torii gate at the Cal Poly Arboretum this fall! Learn by doing - Armstrong would be proud.",
    image: torii,
    color: "var(--color-orange)",
  },
  {
    title: "ゲンKEY",
    description:
      "JSA's very own band performing at JSA events, PCW, and more! GenKey is the place for creating, sharing, or enjoying music!",
    image: genkey,
    color: "var(--color-pink)",
    jpTitle: true,
  },
];
---

<BaseLayout title="Cal Poly JSA | Japanese Student Association">
  <!-- Hero -->
  <section class="hero">
    <Image
      class="hero__image"
      src={hero}
      alt="JSA members posing in front of a pier at the beach"
      width={1920}
      height={813}
      loading="eager"
    />
    <div class="hero__stage">
      <Image class="hero__arrow hero__arrow--left" src={heroArrowLeft} alt="" width={30} height={59} />
      <Image class="hero__arrow hero__arrow--right" src={heroArrowRight} alt="" width={30} height={59} />
      <h1 class="hero__title">
        <span class="hero__title-line hero__title-line--white">WE ARE</span>
        <span class="hero__title-line hero__title-line--red">JSA</span>
      </h1>
      <a class="hero__button" href="/board">ようこそ!</a>
    </div>
  </section>

  <!-- Welcome -->
  <section class="welcome container">
    <div class="photo-frame welcome__photo">
      <Image src={welcome} alt="A large group of JSA members posing outdoors" width={1056} height={702} />
    </div>
    <div class="welcome__text">
      <h2 class="welcome__heading">Welcome :D</h2>
      <p class="welcome__lead">
        We are Cal Poly's Japanese Student Association, dedicated to sharing and celebrating Japanese culture in
        addition to fostering a JSA "family" on campus.
      </p>
      <p class="welcome__open">JSA is open to everyone at Cal Poly!</p>
    </div>
  </section>

  <!-- Join the family -->
  <section class="band join">
    <div class="container join__inner">
      <div class="join__text">
        <h2 class="join__heading">Join the family!!</h2>
        <p>
          The easiest way to join JSA is to drop by our general meetings - in Baker 107, every Wednesday at 7pm. We
          hope to see you there!
        </p>
        <p>
          Follow the <a href="https://www.instagram.com/calpolyjsa" class="join__link">Cal Poly JSA Instagram</a>
          (@calpolyjsa) where we post club updates and event/meeting reminders! You can also join the JSA GroupMe or dm
          the instagram for more info!
        </p>
      </div>
      <div class="photo-frame photo-frame--crimson join__photo">
        <Image src={join} alt="JSA members smiling together in a park" width={956} height={666} />
      </div>
    </div>
  </section>

  <!-- Our events -->
  <section class="events container">
    <div class="photo-frame events__photo">
      <Image src={events} alt="Smiling JSA members in front of blooming flowers" width={1030} height={770} />
    </div>
    <div class="events__text">
      <h2 class="events__heading">Our Events</h2>
      <p>
        JSA hosts weekly general meetings and weekend events, as well as project teams, and SPOOOORTS to keep your
        calendar packed with fun times.
      </p>
      <p>
        Like most culture clubs on campus, JSA also has a “senpai-kouhai” (big-little) program that pairs older,
        experienced members with new members.
      </p>
    </div>
  </section>

  <!-- Projects -->
  <section class="projects">
    <h2 class="band band-title">JSA Projects</h2>
    <div class="container projects__cards">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>

  <!-- Instagram -->
  <section class="instagram">
    <h2 class="band band-title">Follow JSA on Insta!</h2>
    <!-- TODO: Instagram embed. The Wix site shows an empty 980x304 widget here, so it stays blank for now. -->
    <div class="container instagram__embed" aria-hidden="true"></div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero (79 to 689) ---------- */
  .hero {
    position: relative;
    height: 610px;
    background: var(--color-lavender);
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__stage {
    position: relative;
    width: var(--page-width);
    height: 100%;
    margin-inline: auto;
  }

  .hero__arrow {
    position: absolute;
    top: 274.2px;
    width: 30px;
    height: 58.6px;
  }

  .hero__arrow--left {
    left: 100px;
  }

  .hero__arrow--right {
    left: 1310px;
  }

  .hero__title {
    position: absolute;
    top: 254px;
    left: 0;
    right: 0.5px;
    font-family: var(--font-display);
    font-size: 80px;
    font-weight: var(--weight-regular);
    line-height: 56px;
    text-align: center;
  }

  .hero__title-line {
    display: block;
  }

  .hero__title-line--white {
    color: var(--color-white);
    letter-spacing: -4px;
  }

  .hero__title-line--red {
    color: var(--color-red);
    letter-spacing: 4px;
  }

  .hero__button {
    position: absolute;
    top: 398px;
    left: 634px;
    width: 166px;
    height: 47px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 23.5px;
    background: var(--color-coral);
    color: var(--color-white);
    font-family: var(--font-jp);
    font-size: 14px;
    font-weight: var(--weight-bold);
  }

  /* ---------- Shared photo frame: white border + shadow, rounded photo ---------- */
  .photo-frame {
    border: 2px solid var(--color-white);
    border-radius: 10px;
    background: var(--color-white);
    box-shadow: var(--shadow-frame);
    overflow: hidden;
    flex: none;
  }

  .photo-frame--crimson {
    border-color: var(--color-crimson);
    background: var(--color-crimson);
  }

  .photo-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  /* ---------- Welcome (689 to 1153) ---------- */
  .welcome {
    height: 464px;
    padding-top: 74px;
    display: flex;
    align-items: flex-start;
    gap: 45px;
  }

  .welcome__photo {
    width: 532px;
    height: 355px;
  }

  .welcome__text {
    margin-top: 31.9px;
    width: 391px;
    font-size: 17px;
    line-height: 29.8px;
  }

  .welcome__heading {
    color: var(--color-red);
    font-size: 41px;
    font-weight: var(--weight-regular);
    line-height: 71.8px;
  }

  .welcome__open {
    margin-top: 29.4px;
  }

  /* ---------- Join the family (1153 to 1594) ---------- */
  .join {
    height: 441px;
    background: var(--color-red);
  }

  .join__inner {
    display: flex;
    align-items: flex-start;
    height: 100%;
  }

  .join__text {
    margin: 76px 0 0 35px;
    width: 391px;
    color: var(--color-white);
    font-size: 17px;
    line-height: 23.5px;
  }

  .join__heading {
    margin-bottom: 23.5px;
    font-size: 41px;
    font-weight: var(--weight-bold);
    line-height: 23.5px;
  }

  .join__text p + p {
    margin-top: 23.5px;
  }

  .join__link {
    text-decoration: underline;
  }

  .join__photo {
    margin: 53px 0 0 27px;
    width: 482px;
    height: 337px;
  }

  /* ---------- Our events (1594 to 2064) ---------- */
  .events {
    height: 470px;
    padding-top: 28px;
    display: flex;
    align-items: flex-start;
    gap: 23px;
  }

  .events__photo {
    margin-left: 35px;
    width: 519px;
    height: 389px;
  }

  .events__text {
    margin-top: 37px;
    width: 391px;
    color: var(--color-ink);
    font-size: 17px;
    line-height: 23.5px;
  }

  .events__heading {
    margin-bottom: 23.5px;
    color: var(--color-red);
    font-size: 41px;
    font-weight: var(--weight-bold);
    line-height: 23.5px;
  }

  .events__text p + p {
    margin-top: 23.5px;
  }

  /* ---------- Section title bands (JSA Projects / Follow JSA on Insta!) ---------- */
  .band-title {
    height: 178.4px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-red);
    color: var(--color-white);
    font-size: 72px;
    font-weight: var(--weight-semibold);
    line-height: 86.4px;
  }

  /* ---------- Projects ---------- */
  .projects__cards {
    margin-top: 15px;
    margin-bottom: 29px;
    padding-left: 4px;
    display: flex;
    align-items: flex-start;
    gap: 23px;
  }

  /* ---------- Instagram ---------- */
  .instagram__embed {
    height: 304px;
    margin-top: 12px;
  }
</style>
