  }

  .gallery__subtitle {
    left: 150px;
    top: 97.8px;
    font-size: 15px;
    font-weight: var(--weight-extralight);
    line-height: 21px;
    white-space: nowrap;
  }

  .gallery__title-rule {
    left: 150px;
    top: 134px;
    width: 139px;
    height: 1px;
    background: var(--color-line);
  }

  /* ---------- Featured event ---------- */
  .featured {
    left: 0;
    top: 148px;
    width: 980px;
  }

  .featured > * {
    position: absolute;
  }

  .featured__photo {
    left: 22px;
    top: 0;
    width: 553px;
    height: 338px;
    border: 2px solid var(--color-white);
    border-radius: 20px;
    background: var(--color-white);
