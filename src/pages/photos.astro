    top: 148px;
    height: 2493px;
    background: var(--color-gray-bg);
  }

  .gallery__backdrop--left {
    left: 0;
    width: 588px;
  }

  .gallery__backdrop--right {
    left: 588px;
    width: 392px;
  }

  /* ---------- Banner ---------- */
