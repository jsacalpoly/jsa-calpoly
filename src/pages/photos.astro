  }

  .gallery__banner-art {
    left: 376px;
    top: 0;
    width: 616px;
    height: 164px;
  }

  .gallery__logo {
    left: 22px;
    top: 24px;
    width: 101px;
    height: 95px;
  }

  .gallery__title {
    left: 145px;
    top: 23.9px;
