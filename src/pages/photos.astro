    left: 591.5px;
    top: 7.5px;
    width: 1px;
    height: 216px;
    background: var(--color-line);
  }

  .featured__title {
    left: 616px;
    top: 12.5px;
    font-family: var(--font-mono);
    font-size: 30px;
    font-weight: var(--weight-regular);
    line-height: 36px;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .featured__text,
  .featured__prompt {
    left: 616px;
    font-size: 15px;
    font-weight: var(--weight-extralight);
    line-height: 21px;
  }

  .featured__text {
    top: 60px;
    width: 311px;
  }

