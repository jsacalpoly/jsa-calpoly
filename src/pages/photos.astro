---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoEventCard from "../components/PhotoEventCard.astro";

import featuredPhoto from "../assets/photos/featured-pismo.jpg";
import bannerBlossoms from "../assets/photos/banner-blossoms.png";
import galleryLogo from "../assets/photos/gallery-logo.png";
import cameraIcon from "../assets/photos/camera-icon.png";

const events = (await getCollection("events")).sort((a, b) => a.data.order - b.data.order);
const featured = events[0];
const { Content: FeaturedBody } = await render(featured);

// Newest first, alternating between the two columns like the Wix gallery.
const columns = [events.filter((_, i) => i % 2 === 0), events.filter((_, i) => i % 2 === 1)];
const renderedColumns = await Promise.all(
  columns.map((column) =>
    Promise.all(
      column.map(async (event) => {
        const { Content } = await render(event);
        return { event, Content };
      }),
    ),
  ),
);
---

<BaseLayout title="Photos | Cal Poly JSA" description="Photo gallery of Cal Poly JSA events.">
  <div class="gallery container">
    <!-- Gray backdrops behind the featured event and card columns (Figma stops them at y=2720). -->
    <span class="gallery__backdrop gallery__backdrop--left"></span>
    <span class="gallery__backdrop gallery__backdrop--right"></span>

    <!-- Banner -->
    <header class="gallery__banner">
      <Image class="gallery__banner-art" src={bannerBlossoms} alt="" width={616} height={164} />
      <Image class="gallery__logo" src={galleryLogo} alt="JSA logo" width={101} height={95} />
      <h1 class="gallery__title">Photo Gallery</h1>
      <p class="gallery__subtitle">Capturing those precious memories</p>
      <span class="gallery__title-rule"></span>
    </header>

    <!-- Featured event -->
    <section class="featured">
      <div class="featured__photo">
        <Image src={featuredPhoto} alt="Three JSA members on the beach at Pismo" width={1098} height={668} />
      </div>
      <span class="featured__divider"></span>
      <h2 class="featured__title">{featured.data.title}</h2>
      <div class="featured__text"><FeaturedBody /></div>
      <p class="featured__prompt">Please add any photos you took!!</p>
      <a class="featured__button" href={featured.data.album ?? "#"} target="_blank" rel="noopener noreferrer">
        <span>Photos!!</span>
        <Image src={cameraIcon} alt="" width={37} height={37} />
      </a>
    </section>
    <span class="gallery__rule"></span>

    <!-- Event cards -->
    {
      renderedColumns.map((column, index) => (
        <div class:list={["cards", index === 0 ? "cards--left" : "cards--right"]}>
          {column.map(({ event, Content }) => (
            <PhotoEventCard title={event.data.title} cover={event.data.cover} album={event.data.album}>
              <Content />
            </PhotoEventCard>
          ))}
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  /* 79 to 3252 (the footer gap follows). Every position below is relative to the 980px column that starts at x=230. */
