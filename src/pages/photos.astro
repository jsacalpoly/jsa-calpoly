  }

  .featured__button {
    left: 607px;
    top: 293px;
    width: 353px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 22.5px;
    background: var(--color-green);
    color: var(--color-white);
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: var(--weight-light);
    letter-spacing: 3.8px;
  }

  .featured__button span {
    /* Figma centers the label on the full button, ignoring the camera icon. */
    flex: 1;
    text-align: center;
  }

  .featured__button :global(img) {
    position: absolute;
    left: 205.6px;
    top: 4px;
    width: 37px;
    height: 37px;
  }

  .gallery__rule {
    left: 136px;
    top: 513px;
    width: 315px;
    height: 1px;
    background: var(--color-line);
  }

  /* ---------- Event cards ---------- */
  .cards {
    top: 548px;
    display: flex;
    flex-direction: column;
    gap: 21px;
  }

  .cards--left {
    left: 11px;
  }

  .cards--right {
    left: 495px;
  }
</style>
