---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EraCard from "../components/EraCard.astro";
import EraRow from "../components/EraRow.astro";

import blossomsLeft from "../assets/board/blossoms-left.png";
import blossomsRight from "../assets/board/blossoms-right.png";
import headerFlower from "../assets/eras/header-flower.png";
import ornament from "../assets/eras/ornament-flower.png";
import blossom from "../assets/eras/blossom.png";

const eras = (await getCollection("eras")).sort((a, b) => a.data.order - b.data.order);
// Newest era gets the wide feature card, the next three sit in a row, the rest are the archive.
const [last, ...rest] = eras.filter((era) => era.data.size === "large");
const recent = rest;
const archive = eras.filter((era) => era.data.size === "small");
const archiveRows = [archive.slice(0, 3), archive.slice(3, 6), archive.slice(6, 9)].filter((row) => row.length > 0);
// On phones the recent and earlier eras share one timeline.
const timeline = [...recent, ...archive];

// Will Kriss's White Dream reflection, shown in full on desktop and in a sheet on phones.
const reflection = {
  highlights:
    "The general meetings were definitely my favorite part of the White Dream era. Going through a period of transition from small club to big club, the general meetings were the main time we got to interact and entertain the majority of JSA. I really like to think that we made our general meetings unique and exciting every week. It's hard to narrow it down, but some of my favorite things we did were: rats being thrown at me, laser pointer, eating a whole thing of cabbage, T-posing for way too long, and punishment jan-ken-pon. I absolutely loved the energy at the meetings and I think that's where we as a board shined the brightest.",
  advice:
    'There are two main responsibilities or elements or whatever you want to call it for being on JSA board. The first is obviously making stuff happen. You can plan it all out beforehand or learn how to do it on the fly, but you have a responsibility to make things actually happen. The second element is creative direction. JSA is weird. Not in like a "society doesn\'t understand me" weird, but a fun, do things out of the box type of way. Be creative. Try to do things differently. The worst thing you can be is boring.',
  passion:
    "Now none of this is going to happen without your passion. Find what you're passionate about and find a way to bring it into JSA. Keep in mind that what you want to do needs to be for the best of the club, but the club won't strive unless you fully believe in what you're doing. If you're passionate about what you're doing for the club, it will show and you'll be able to go above and beyond.",
  love: "AS ALWAYS love y'all <3 <3 <3",
  sign: "- Will Kriss",
};
---

<BaseLayout
  title="Eras | Cal Poly JSA"
  description="JSA board through the eras: honoring our founders."
  flushFooter
  responsive
>
  <!-- Banner (79 to 257) -->
  <section class="banner">
    <div class="stage banner__stage">
      <div class="banner__blossoms-right">
        <Image src={blossomsRight} alt="" width={458} height={305} />
      </div>
      <Image class="banner__blossoms-left" src={blossomsLeft} alt="" width={238} height={212} />

      <p class="banner__kicker">Our Legacy</p>
      <h1 class="banner__title" data-reveal>
        JSA Board Through the Eras
      </h1>
      <p class="banner__subtitle">Honoring our founders</p>

      <span class="banner__rule banner__rule--left" data-reveal="line" style="--reveal-delay: 0.15s"></span>
      <Image
        class="banner__flower"
        src={headerFlower}
        alt=""
        width={45}
        height={45}
        data-reveal
        style="--reveal-delay: 0.1s"
      />
      <span class="banner__rule banner__rule--right" data-reveal="line" style="--reveal-delay: 0.15s"></span>
    </div>
  </section>

  <!-- Phone banner -->
  <section class="banner-m">
    <Image class="banner-m__branch banner-m__branch--right" src={blossomsRight} alt="" width={458} height={305} />
    <Image class="banner-m__branch banner-m__branch--left" src={blossomsLeft} alt="" width={238} height={212} />
    <p class="banner-m__kicker">
      <span class="banner-m__rule"></span>
      <span>Our Legacy</span>
      <span class="banner-m__rule"></span>
    </p>
    <h1 class="banner-m__title">JSA Board Through the Eras</h1>
    <p class="banner-m__subtitle">Honoring our founders</p>
    <Image class="banner-m__flower" src={headerFlower} alt="" width={45} height={45} />
  </section>

  <!-- Eras -->
  <section class="eras">
    <div class="eras__drift" aria-hidden="true">
      <Image class="eras__blossom eras__blossom--a" src={blossom} alt="" width={304} height={308} />
      <Image class="eras__blossom eras__blossom--b" src={blossom} alt="" width={304} height={308} />
      <Image class="eras__blossom eras__blossom--c" src={blossom} alt="" width={304} height={308} />
    </div>

    <div class="eras__inner container">
      {last && <EraCard {...last.data} variant="feature" badge="Last era" />}

      <div class="eras__heading" data-reveal="up">
        <span class="eras__jp">近年</span>
        <h2 class="eras__title">Recent eras</h2>
        <div class="eras__divider">
          <span></span>
          <Image src={ornament} alt="" width={34} height={40} />
          <span></span>
        </div>
      </div>
      <div class="eras__row">
        {recent.map((era, i) => (
          <EraCard {...era.data} variant="recent" delay={i * 0.08} />
        ))}
      </div>

      <div class="eras__heading" data-reveal="up">
        <span class="eras__jp">歴代</span>
        <h2 class="eras__title">Earlier eras</h2>
        <div class="eras__divider">
          <span></span>
          <Image src={ornament} alt="" width={34} height={40} />
          <span></span>
        </div>
      </div>
      {archiveRows.map((row) => (
        <div class="eras__row">
          {row.map((era, i) => (
            <EraCard {...era.data} variant="small" delay={i * 0.06} />
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- Phone: the last era, then every other era as a timeline you tap open -->
  <section class="eras-m">
    {last && (
      <div class="eras-m__last">
        <EraCard {...last.data} variant="feature" badge="Last era" />
      </div>
    )}

    <div class="eras-m__heading">
      <span class="eras__jp">歴代</span>
      <h2 class="eras__title">Through the eras</h2>
      <p class="eras-m__hint">Tap an era to meet its board</p>
    </div>
    <ol class="eras-m__timeline">
      {timeline.map((era, i) => (
        <EraRow {...era.data} id={`era-more-${i}`} />
      ))}
    </ol>
  </section>

  <!-- Will Kriss's White Dream reflection -->
  <section class="reflection">
    <div class="stage reflection__stage">
      <h2 class="reflection__name">WILL KRISS'S</h2>
      <p class="reflection__label reflection__label--highlights">HIGHLIGHTS:</p>
      <p class="reflection__text reflection__text--highlights">{reflection.highlights}</p>

      <p class="reflection__label reflection__label--advice">ADVICE FOR FUTURE JSA:</p>
      <p class="reflection__text reflection__text--advice">{reflection.advice}</p>
      <p class="reflection__text reflection__text--passion">{reflection.passion}</p>

      <h2 class="reflection__title">
        <span class="reflection__title-line reflection__title-line--white-dream">WHITE DREAM</span>
        <span class="reflection__title-line reflection__title-line--reflection">REFLECTION</span>
      </h2>
      <p class="reflection__love">{reflection.love}</p>
      <p class="reflection__sign">{reflection.sign}</p>
    </div>
  </section>

  <!-- Phone: a teaser for Will Kriss's reflection, which opens in a sheet -->
  <section class="reflection-m">
    <h2 class="reflection-m__name">WILL KRISS'S</h2>
    <p class="reflection-m__label">WHITE DREAM REFLECTION</p>
    <p class="reflection-m__quote">“The worst thing you can be is boring.”</p>
    <button class="reflection-m__button" type="button" data-reflection-open>
      Read the reflection&nbsp;&nbsp;→
    </button>
  </section>

  <div
    class="sheet"
    id="reflection-sheet"
    role="dialog"
    aria-modal="true"
    aria-label="Will Kriss's White Dream reflection"
    hidden
  >
    <button class="sheet__dim" type="button" aria-label="Close" tabindex="-1" data-reflection-close></button>
    <div class="sheet__panel">
      <span class="sheet__handle" aria-hidden="true"></span>
      <button class="sheet__close" type="button" aria-label="Close" data-reflection-close>
        <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
          <path d="M1 1 11 11M11 1 1 11"></path>
        </svg>
      </button>
      <div class="sheet__scroll">
        <h2 class="sheet__name">WILL KRISS'S</h2>
        <p class="sheet__title">WHITE DREAM REFLECTION</p>
        <p class="sheet__label">HIGHLIGHTS:</p>
        <p class="sheet__text">{reflection.highlights}</p>
        <p class="sheet__label">ADVICE FOR FUTURE JSA:</p>
        <p class="sheet__text">{reflection.advice}</p>
        <p class="sheet__text">{reflection.passion}</p>
        <p class="sheet__love">{reflection.love}</p>
        <p class="sheet__sign">{reflection.sign}</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Phones: the era timeline opens one era at a time.
  const heads = document.querySelectorAll<HTMLButtonElement>(".era-row__head");
  heads.forEach((head) =>
    head.addEventListener("click", () => {
      const wasOpen = head.getAttribute("aria-expanded") === "true";
      heads.forEach((other) => other.setAttribute("aria-expanded", "false"));
      head.setAttribute("aria-expanded", String(!wasOpen));
    }),
  );

  // Phones: Will Kriss's reflection opens in a sheet that slides up over the page.
  const sheet = document.querySelector<HTMLElement>("#reflection-sheet");
  const openers = document.querySelectorAll<HTMLElement>("[data-reflection-open]");
  const closers = document.querySelectorAll<HTMLElement>("[data-reflection-close]");

  function setSheet(open: boolean) {
    if (!sheet) return;
    sheet.hidden = !open;
    document.documentElement.style.overflow = open ? "hidden" : "";
    if (open) sheet.querySelector<HTMLElement>(".sheet__close")?.focus();
    else openers[0]?.focus();
  }

  openers.forEach((el) => el.addEventListener("click", () => setSheet(true)));
  closers.forEach((el) => el.addEventListener("click", () => setSheet(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && sheet && !sheet.hidden) setSheet(false);
  });
</script>

<style>
  /* Everything is positioned against the 1440px design width. */
  .stage {
    position: relative;
    width: var(--page-width);
    margin-inline: auto;
  }

  /* ---------- Banner (79 to 257) ---------- */
  .banner {
    height: 178px;
    background: var(--color-off-white);
    position: relative;
    z-index: 1;
  }

  .banner__stage {
    height: 100%;
  }

  /* The right blossoms start 37px above the banner, behind the header. Show only the part below it. */
  .banner__blossoms-right {
    position: absolute;
    left: 838px;
    top: 0;
    width: 458px;
    height: 268px;
    overflow: hidden;
    pointer-events: none;
  }

  .banner__blossoms-right :global(img) {
    width: 458px;
    height: 305px;
    margin-top: -37px;
  }

  .banner__blossoms-left {
    position: absolute;
    left: 138px;
    top: 0;
    width: 238px;
    height: 212px;
    pointer-events: none;
  }

  .banner__kicker,
  .banner__title,
  .banner__subtitle {
    position: absolute;
    white-space: nowrap;
  }

  .banner__kicker {
    left: 634px;
    top: 13px;
    font-size: 30px;
    font-weight: var(--weight-extralight);
    line-height: 42px;
  }

  .banner__title {
    left: 725.5px;
    top: 56.5px;
    translate: -50% 0;
    color: var(--color-salmon);
    font-family: var(--font-serif);
    font-size: 43px;
    font-weight: var(--weight-regular);
    line-height: 43px;
    text-align: center;
  }

  .banner__subtitle {
    left: 614px;
    top: 101px;
    font-size: 20px;
    font-weight: var(--weight-extralight);
    line-height: 28px;
  }

  .banner__rule {
    position: absolute;
    top: 151px;
    width: 405px;
    height: 1px;
    background: var(--color-line);
  }

  .banner__rule--left {
    left: 230px;
  }

  .banner__rule--right {
    left: 790px;
  }

  .banner__flower {
    position: absolute;
    left: 698px;
    top: 129px;
    width: 45px;
    height: 45px;
  }

  /* ---------- Eras ---------- */
  .eras {
    position: relative;
    padding: 72px 0 96px;
    background: var(--color-peach);
    overflow: hidden;
  }

  .eras__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .eras__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .eras__heading {
