  }

  .reflection__label--highlights {
    left: 640px;
    top: 15.7px;
  }

  .reflection__text--highlights {
    left: 640px;
    top: 36.4px;
    width: 529px;
  }

  .reflection__label--advice {
    left: 240px;
    top: 196.9px;
  }

  .reflection__text--advice {
    left: 240px;
    top: 217.6px;
    width: 537px;
  }

  .reflection__text--passion {
    left: 240px;
    top: 360.4px;
    width: 537px;
  }

  .reflection__title {
    left: 785px;
    top: 279.8px;
    width: 415px;
    font-size: 70px;
    font-weight: var(--weight-semibold);
    line-height: 49px;
    text-align: right;
  }

  .reflection__title-line {
    display: block;
  }

  .reflection__title-line--reflection {
    /* Figma sets this line 1px left of the others. */
