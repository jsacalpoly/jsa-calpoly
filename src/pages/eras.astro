    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .eras__jp {
    color: var(--color-red);
    font-family: var(--font-serif-jp);
    font-size: 15px;
    font-weight: var(--weight-medium);
  }

  .eras__title {
    color: var(--color-ink);
    font-size: 32px;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
  }

  .eras__divider {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 300px;
  }

  .eras__divider span {
    flex: 1;
    height: 1px;
    background: #fbd0cc;
  }

  .eras__divider :global(img) {
    width: 17px;
    height: auto;
  }

  /* Faint blossoms drifting at the page edges, placed against the 1440px design width. */
