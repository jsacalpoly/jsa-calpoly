    left: -46px;
    top: 1230px;
    rotate: 25deg;
  }

  .eras__blossom--c {
    left: 1190px;
    top: 1980px;
    rotate: 10deg;
    opacity: 0.6;
  }

  .eras__inner {
    position: relative;
  }

  /* ---------- Reflection band (3046.2 to 3596.4) ---------- */
  .reflection {
    margin-top: 3px;
    height: 550.2px;
    background: var(--color-rose);
