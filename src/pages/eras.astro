    white-space: nowrap;
  }

  .reflection__love {
    left: 803px;
    top: 440.9px;
    font-family: var(--font-accent);
    font-size: 12px;
    font-weight: var(--weight-light);
    line-height: 20.4px;
    white-space: nowrap;
  }

  .reflection__sign {
    left: 1113px;
    top: 481.6px;
    width: 68px;
    font-family: var(--font-accent);
    font-size: 16px;
    font-style: italic;
    font-weight: var(--weight-light);
    line-height: 27.2px;
    text-align: right;
    white-space: nowrap;
  }

  /* ---------- Phone-only pieces stay out of the desktop page ---------- */
  .banner-m,
  .eras-m,
  .reflection-m,
  .sheet {
    display: none;
  }

  /* ---------- Phone: banner, a timeline of eras, and a reflection sheet ---------- */
  @media (max-width: 768px) {
    .banner,
    .eras,
    .reflection {
      display: none;
    }

    .banner-m {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: 22px 24px;
      overflow: hidden;
      background: var(--color-off-white);
      text-align: center;
    }

    .banner-m > * {
      position: relative;
    }

    .banner-m > :global(.banner-m__branch) {
      position: absolute;
      height: auto;
      pointer-events: none;
    }

    .banner-m > :global(.banner-m__branch--right) {
      top: -26px;
      right: -30px;
      width: 150px;
    }

    .banner-m > :global(.banner-m__branch--left) {
      top: -6px;
      left: -18px;
      width: 96px;
    }

    .banner-m__kicker {
      display: flex;
      gap: 12px;
      align-items: center;
      width: 100%;
      font-size: 20px;
      font-weight: var(--weight-extralight);
      line-height: 28px;
    }

    .banner-m__rule {
      flex: 1;
      height: 1px;
      background: var(--color-line);
    }

    .banner-m__title {
      color: var(--color-salmon);
      font-size: 22px;
      font-weight: var(--weight-regular);
      line-height: 30px;
    }

    .banner-m__subtitle {
      font-size: 14px;
      font-weight: var(--weight-extralight);
    }

    .banner-m > :global(.banner-m__flower) {
      width: 26px;
      height: 26px;
    }

    /* Eras: the last era, then a timeline on a dotted thread. */
    .eras-m {
      display: block;
      padding: 30px 0 44px;
      background: var(--color-peach);
    }

    .eras-m__last {
      padding: 14px 24px 0;
    }

    .eras-m__heading {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      padding: 36px 24px 18px;
      text-align: center;
    }

    .eras-m__heading .eras__jp {
      font-size: 14px;
    }

    .eras-m__heading .eras__title {
      font-size: 28px;
      line-height: 34px;
    }

    .eras-m__hint {
      color: var(--color-text-muted);
      font-size: 12px;
      font-weight: var(--weight-light);
    }

    .eras-m__timeline {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin: 0;
      padding: 0 24px;
      list-style: none;
    }

    /* The dotted coral thread the blossoms sit on. */
    .eras-m__timeline::before {
      content: "";
      position: absolute;
      top: 28px;
      bottom: 50px;
      left: 39px;
      width: 2px;
      background: radial-gradient(circle, var(--color-coral) 1px, transparent 1.4px) 0 0 / 2px 8px repeat-y;
    }

    .eras-m__timeline > :global(.era-row) {
      position: relative;
      z-index: 1;
    }

    /* Will Kriss's reflection: a teaser; the full text opens in a sheet. */
    .reflection-m {
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding: 40px 24px 44px;
      background: var(--color-rose);
      color: var(--color-white);
    }

    .reflection-m__name {
      font-size: 46px;
      font-weight: var(--weight-bold);
      letter-spacing: -0.03em;
      line-height: 48px;
    }

    .reflection-m__label {
      font-size: 24px;
      font-weight: var(--weight-semibold);
      line-height: 30px;
    }

    .reflection-m__quote {
      font-family: var(--font-accent);
      font-size: 15px;
      font-style: italic;
      font-weight: var(--weight-light);
      line-height: 23px;
    }

    .reflection-m__button {
      width: 100%;
      padding: 14px 0;
      border: 0;
      border-radius: 999px;
      background: var(--color-white);
      color: var(--color-rose);
      font: inherit;
      font-size: 14px;
      font-weight: var(--weight-medium);
      cursor: pointer;
    }

    .sheet {
      position: fixed;
      inset: 0;
      z-index: 80;
      display: block;
    }

    .sheet[hidden] {
      display: none;
    }

    .sheet__dim {
      position: absolute;
      inset: 0;
      border: 0;
      background: rgba(0, 0, 0, 0.5);
      animation: sheet-fade 0.25s ease both;
    }

    .sheet__panel {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      height: calc(100% - 144px);
      overflow: hidden;
      border-radius: 28px 28px 0 0;
      background: var(--color-rose);
      color: var(--color-white);
      animation: sheet-up 0.3s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }

    /* A soft fade at the bottom hints that the text scrolls. */
    .sheet__panel::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      height: 70px;
      background: linear-gradient(to bottom, transparent, var(--color-rose));
      pointer-events: none;
    }

    .sheet__handle {
      position: absolute;
      top: 12px;
      left: 50%;
      width: 40px;
      height: 4px;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.7);
      translate: -50% 0;
    }

    .sheet__close {
      position: absolute;
      top: 26px;
      right: 24px;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--color-white);
      cursor: pointer;
    }

    .sheet__close path {
      fill: none;
      stroke: var(--color-ink);
      stroke-width: 1.6;
      stroke-linecap: round;
    }

    .sheet__scroll {
      display: flex;
      flex: 1;
