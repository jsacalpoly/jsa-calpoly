---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EventCard from "../components/EventCard.astro";
import TicketCard from "../components/TicketCard.astro";
import {
  buildWeeks,
  comingUp,
  doodles,
  layoutWeek,
  monthName,
  ticketLook,
  todayInSlo,
  weekdayName,
  type CalendarEntry,
} from "../utils/calendar";

import blossom from "../assets/eras/blossom.png";
import flowerDivider from "../assets/board/flower-divider.png";

const entries: CalendarEntry[] = (await getCollection("calendar")).map((entry) => ({ id: entry.id, ...entry.data }));

// The week always runs Wednesday to Tuesday. Half a year of weeks is built ahead, and a small script on the page shows the
// one that matches the visitor's today, so the board stays right between deploys.
const today = todayInSlo();
const weeks = buildWeeks(entries, today, 26).map((week) => ({ week, layout: layoutWeek(week) }));
const big = comingUp(entries, today);

const tilts = [-0.8, 0.9, -0.6];
const shifts = [14, -18, 6];
---

<BaseLayout
  title="Calendar | Cal Poly JSA"
  description="What is happening this week with the Cal Poly Japanese Student Association."
  responsive
>
  <section class="forecast">
    <div class="forecast__inner">
      <div class="board" data-reveal="up">
        <Image class="board__blossom board__blossom--top" src={blossom} alt="" width={70} />
        <Image class="board__blossom board__blossom--bottom" src={blossom} alt="" width={52} />

        <div class="board__head">
          <div class="tile tile--sun" aria-hidden="true">
            <svg viewBox="0 0 100 100">
              <g stroke="#f4b93a" stroke-width="5" stroke-linecap="round">
                <path d="M38 12v8M38 56v8M14 38h8M54 38h8M21 21l6 6M55 21l-6 6M21 55l6-6"></path>
              </g>
              <circle cx="38" cy="38" r="17" fill="#fbd84a"></circle>
              <path
                d="M48 74a12 12 0 0 1 4-23 16 16 0 0 1 30 4 11 11 0 0 1 2 22H52a9 9 0 0 1-4-3z"
                fill="#fff"
                stroke="#e6e1de"
                stroke-width="2"
              ></path>
            </svg>
          </div>

          <div class="board__title">
            <h1>FORECAST</h1>
            <div class="board__divider" aria-hidden="true">
              <Image src={flowerDivider} alt="" width={20} />
            </div>
            <p class="board__range">
              <span class="heading heading--now">This week at JSA</span>
              <span class="heading heading--next">Next week (preview) &nbsp;·&nbsp; plans may change</span>
              <span class="heading heading--next-short">Preview &nbsp;·&nbsp; may change</span>
              <span class="range-dot">&nbsp;·&nbsp;</span>{" "}
              <span class="range-dates" data-range>
                {weeks[0].week.label}
              </span>
            </p>
            <div class="board__toggle" role="group" aria-label="Choose a week">
              <span class="board__thumb" aria-hidden="true"></span>
              <button type="button" data-view="current" aria-pressed="true">
                This week
              </button>
              <button type="button" data-view="next" aria-pressed="false">
                Next week <span>preview</span>
              </button>
            </div>
          </div>

          <div class="tile tile--calendar" aria-hidden="true">
            <svg viewBox="0 0 100 100">
              <rect x="20" y="26" width="60" height="54" rx="8" fill="#fff" stroke="#d6786e" stroke-width="4"></rect>
              <path d="M20 34a8 8 0 0 1 8-8h44a8 8 0 0 1 8 8v10H20z" fill="#d6786e"></path>
              <path d="M34 18v14M66 18v14" stroke="#b8584e" stroke-width="5" stroke-linecap="round"></path>
              <g fill="#e1dcda">
                <rect x="28" y="52" width="10" height="8" rx="2"></rect>
                <rect x="45" y="52" width="10" height="8" rx="2"></rect>
                <rect x="62" y="52" width="10" height="8" rx="2"></rect>
                <rect x="28" y="66" width="10" height="8" rx="2"></rect>
                <rect x="45" y="66" width="10" height="8" rx="2"></rect>
              </g>
            </svg>
          </div>
        </div>

        {weeks.map(({ week, layout }, index) => (
          <div class="week" data-week-start={week.start} data-label={week.label} hidden={index !== 0}>
            <ol
              class="days"
              style={`--column-height: ${layout.columnHeight}px; --phone-height: ${layout.phoneHeight}px`}
            >
              <svg
                class="thread"
                viewBox={`0 0 326 ${layout.phoneHeight}`}
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <path d={layout.thread} />
              </svg>
              {layout.days.map(({ day, slots, breaks, phoneHeight }, dayIndex) => (
                <li class="day" data-date={day.key} style={`--day-height: ${phoneHeight}px; --col: ${dayIndex + 1}`}>
                  <div class="day__pill">
                    <span class="day__badge">TODAY</span>
                    <span class="day__name">{day.name}</span>
                    <span class="day__number">{day.dayOfMonth}</span>
                  </div>
                  <div class="day__column">
                    <span class="day__kanji" aria-hidden="true">
                      {day.kanji}
                    </span>
                    <div class="day__events">
                      {slots.map(({ event, top, tilt, wobble }) => (
                        <div class="slot" style={`--top: ${top}px; --tilt: ${tilt}deg`}>
                          <EventCard
                            preset={event.preset}
                            title={event.title}
                            time={event.time}
                            place={event.place}
                            wobble={wobble}
                          />
                        </div>
                      ))}
                      {breaks
                        .filter(({ first }) => first)
                        .map(({ event }) => (
                          <div class="slot slot--break">
                            <EventCard
                              preset={event.preset}
                              title={event.title}
                              time={event.time}
                              place={event.place}
                            />
                          </div>
                        ))}
                    </div>
                    {slots.length === 0 && breaks.length === 0 && <p class="day__quiet">nothing planned</p>}
                    {breaks.length > 0 && !breaks[0].first && slots.length === 0 && (
                      <p class="day__quiet day__quiet--break">no events, break</p>
                    )}
                  </div>
                </li>
              ))}
              {layout.spans.map(({ event, start, length }) => (
                <li class="break-span" style={`--col: ${start + 1}; --len: ${length}`}>
                  <article class="break-banner">
                    <svg class="break-banner__doodle" viewBox="0 0 24 24" aria-hidden="true">
                      <path d={doodles[event.preset]} />
                    </svg>
                    <div class="break-banner__text">
                      <h3>{event.title}</h3>
                      <p>{[event.time, event.place].filter(Boolean).join("  ·  ")}</p>
                    </div>
                  </article>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>

      {big.length > 0 && (
        <section class="coming" aria-labelledby="coming-title" data-reveal="up">
          <h2 id="coming-title">Coming up</h2>
          <ol class="coming__list">
            {big.map((entry, i) => (
              <TicketCard
                title={entry.title}
                kicker={entry.date ? weekdayName(entry.date) : "Save the date"}
                month={entry.date ? monthName(entry.date) : "DATE"}
                day={entry.date ? String(entry.date.getUTCDate()) : "TBD"}
                details={[entry.time, entry.place].filter(Boolean).join("   ·   ") || undefined}
                side={i % 2 === 0 ? "right" : "left"}
                look={ticketLook(entry.preset)}
                tilt={tilts[i % tilts.length]}
                shift={shifts[i % shifts.length]}
              />
            ))}
          </ol>
        </section>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  import { addDays, todayInSlo } from "../utils/calendar";

  // Show the week that holds today (Pacific time), and mark today and the days already gone.
  const today = todayInSlo();
  const weeks = [...document.querySelectorAll<HTMLElement>("[data-week-start]")];
  const current =
    weeks.find((week) => today >= week.dataset.weekStart! && today <= addDays(week.dataset.weekStart!, 6)) ??
    (today < weeks[0].dataset.weekStart! ? weeks[0] : weeks[weeks.length - 1]);

  current.querySelectorAll<HTMLElement>("[data-date]").forEach((day) => {
    const date = day.dataset.date!;
    day.classList.toggle("is-today", date === today);
    day.classList.toggle("is-past", date < today);
  });

  // The next week can be previewed. It is marked as tentative so nobody treats it as final.
  const next = weeks[weeks.indexOf(current) + 1];
  const board = document.querySelector<HTMLElement>(".board")!;
  const range = document.querySelector("[data-range]");
  const toggle = document.querySelector<HTMLElement>(".board__toggle");
  const thumb = document.querySelector<HTMLElement>(".board__thumb");
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-view]")];

  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
  let showing: HTMLElement | undefined;

  let latest = 0;

  // The red oval slides under the chosen button instead of blinking between them.
  function moveThumb() {
    const on = buttons.find((button) => button.getAttribute("aria-pressed") === "true");
    if (!toggle || !thumb || !on) return;
    thumb.style.width = `${on.offsetWidth}px`;
    thumb.style.translate = `${on.offsetLeft - 4}px 0`;
    toggle.classList.add("has-thumb");
    // Turn the sliding on only after the first placement, so the oval does not fly in from the corner on load.
    requestAnimationFrame(() => requestAnimationFrame(() => toggle.classList.add("is-ready")));
  }
  window.addEventListener("resize", moveThumb);
  void document.fonts?.ready.then(moveThumb);

  // The week you leave eases out (slow in, slow out), then the new one eases in from the side you are heading to.
  // CSS does the animating; this only swaps the weeks in between.
  function show(view: "current" | "next") {
    const shown = view === "next" && next ? next : current;
    const preview = shown !== current;
    const leaving = showing;
    const changed = leaving !== undefined && leaving !== shown;
    const mine = ++latest;
    buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.view === view)));
    moveThumb();

    function swap() {
      if (mine !== latest) return; // a newer click took over
      weeks.forEach((week) => {
        week.hidden = week !== shown;
        delete week.dataset.leave;
        delete week.dataset.enter;
      });
      if (changed && !calm.matches) {
        shown.dataset.enter = preview ? "next" : "prev";
        shown.addEventListener("animationend", () => delete shown.dataset.enter, { once: true });
      }
      showing = shown;
      board.classList.toggle("is-preview", preview);
      if (range) range.textContent = shown.dataset.label ?? "";
    }

    if (changed && !calm.matches) {
      leaving.dataset.leave = preview ? "next" : "prev";
      leaving.addEventListener("animationend", swap, { once: true });
    } else {
      swap();
    }
  }

  buttons.forEach((button) => button.addEventListener("click", () => show(button.dataset.view as "current" | "next")));
  if (!next) document.querySelector<HTMLElement>(".board__toggle")?.remove();
  show("current");
</script>

<style>
  .forecast {
    --panel: #fffcfa;

    padding: 64px 0 88px;
    background: var(--color-peach);
  }

  .forecast__inner {
    display: flex;
    flex-direction: column;
    gap: 36px;
    width: var(--content-width);
    margin-inline: auto;
  }

  /* ---------- The board ---------- */
  .board {
    position: relative;
    padding: 30px 30px 34px;
    border: 1.5px solid var(--color-kanji);
    border-radius: 34px;
    background: #fff;
    box-shadow: 0 8px 26px rgba(133, 32, 36, 0.08);
  }

  .board__blossom {
    position: absolute;
    height: auto;
    pointer-events: none;
  }

  .board__blossom--top {
    top: -24px;
    left: -26px;
    rotate: -20deg;
  }

  .board__blossom--bottom {
    right: -12px;
    bottom: -14px;
    rotate: 25deg;
  }

  .board__head {
    display: flex;
    gap: 20px;
    align-items: center;
    margin-bottom: 26px;
  }

  .tile {
    display: grid;
    flex: none;
    place-items: center;
    width: 100px;
    height: 100px;
    border-radius: 22px;
    background: #ffe6e2;
  }

  .tile--calendar {
    background: #fcdcdc;
  }

  .tile svg {
    width: 82%;
    height: 82%;
  }

  .board__title {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    padding: 18px 20px 16px;
    border-radius: 26px;
    background: #ffe9e6;
  }

  .board__title h1 {
    color: var(--color-maroon);
    font-size: 76px;
    font-weight: var(--weight-bold);
    letter-spacing: 4px;
    line-height: 1;
  }

  /* A small blossom with a thin line running out to each side. */
  .board__divider {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: center;
    width: 340px;
    max-width: 100%;
  }

  .board__divider::before,
  .board__divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #efc9c5;
  }

  .board__divider :global(img) {
    width: 20px;
    height: auto;
  }

  .board__range {
    color: var(--color-maroon);
    font-size: 14px;
    font-weight: var(--weight-medium);
  }

  /* ---------- Week switch and next-week preview ---------- */
  .board__toggle {
    position: relative;
    display: flex;
    gap: 4px;
    margin-top: 6px;
    padding: 4px;
    border-radius: 999px;
    background: #fff;
  }

  /* The red oval. The script puts it under the chosen button. */
  .board__thumb {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    display: none;
    border-radius: 999px;
    background: var(--color-coral);
  }

  .board__toggle.has-thumb .board__thumb {
    display: block;
  }

  .board__toggle button {
    position: relative;
    padding: 6px 16px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--color-maroon);
    font: inherit;
    font-size: 13px;
    font-weight: var(--weight-medium);
    cursor: pointer;
  }

  .board__toggle button span {
    margin-left: 4px;
    font-size: 11px;
    font-weight: var(--weight-light);
  }

  .board__toggle button[aria-pressed="true"] {
    color: #fff;
  }

  /* Until the script has placed the oval, the chosen button carries the color itself. */
  .board__toggle:not(.has-thumb) button[aria-pressed="true"] {
    background: var(--color-coral);
  }

  .board__toggle button:focus-visible {
    outline: 2px solid var(--color-maroon);
    outline-offset: 2px;
  }

  /* The note that next week may change lives in the title line, so nothing on the board changes size. */
  .heading--next,
  .heading--next-short {
    display: none;
    font-weight: var(--weight-semibold);
  }

  .board.is-preview .heading--now,
  .board.is-preview .heading--next-short {
    display: none;
  }

  .board.is-preview .heading--next {
    display: inline;
  }

  /* Switching weeks: the old week eases out, the new one eases in, and the red oval slides across. */
  @media (prefers-reduced-motion: no-preference) {
    /* Slow in, slow out: the old week eases away, then the new one eases in. */
    .week[data-leave] {
      --to: -24px;

      animation: week-out 0.3s cubic-bezier(0.37, 0, 0.63, 1) forwards;
    }

    .week[data-leave="prev"] {
      --to: 24px;
    }

    .week[data-enter] {
      --from: 24px;

      animation: week-in 0.5s cubic-bezier(0.37, 0, 0.63, 1) both;
    }

    .week[data-enter="prev"] {
      --from: -24px;
    }

    .board__toggle.is-ready .board__thumb {
      transition:
        translate 0.45s cubic-bezier(0.37, 0, 0.63, 1),
        width 0.45s cubic-bezier(0.37, 0, 0.63, 1);
    }

    .board__toggle button {
      transition: color 0.45s cubic-bezier(0.37, 0, 0.63, 1);
    }

    .slot,
    .break-banner {
      transition: opacity 0.4s ease;
    }
  }

  @keyframes week-out {
    to {
      opacity: 0;
      translate: var(--to) 0;
    }
  }

  @keyframes week-in {
    from {
      opacity: 0;
      translate: var(--from) 0;
    }
  }

  /* A previewed week looks unfinished: dashed frame, softer cards. */
  .board.is-preview {
    border-style: dashed;
  }

  .board.is-preview .slot,
  .board.is-preview .break-banner {
    opacity: 0.8;
  }

  /* ---------- Days (desktop: seven tall columns) ---------- */
  .week[hidden] {
    display: none;
  }

  .days {
    position: relative;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thread {
    display: none;
  }

  .day {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;

    /* Each day sits in its own grid column, so the wide break card can lie across several of them. */
    grid-column: var(--col);
    grid-row: 1;
  }

  .day__pill {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 66px;
    border-radius: 24px;
    background: var(--color-kanji);
    color: var(--color-maroon);
    line-height: 1.1;
  }

  .day__name {
    font-size: 28px;
    font-weight: var(--weight-semibold);
  }

  .day__number {
    font-size: 12px;
    font-weight: var(--weight-light);
  }

  .day__badge {
    position: absolute;
    top: -9px;
    display: none;
    padding: 2px 8px;
    border: 1px solid var(--color-coral);
    border-radius: 999px;
    background: #ffeeea;
    color: var(--color-coral);
    font-size: 9px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
  }

  .day__column {
    position: relative;
    height: var(--column-height);
    border: 2px solid transparent;
    border-radius: 56px;
    background: var(--color-peach);
  }

  .day__kanji {
    position: absolute;
    bottom: 22px;
    left: 0;
    width: 100%;
    color: var(--color-kanji);
    font-family: var(--font-serif-jp);
    font-size: 44px;
    line-height: 1;
    text-align: center;
  }

  .slot {
    position: absolute;
    top: var(--top);
    left: 50%;
    width: 112px;
    translate: -50% 0;
    rotate: var(--tilt);
  }

  .day__quiet {
    display: none;
  }

  /* A break (Thanksgiving) is one wide card across its days on desktop, so the per-day pieces stay hidden here. */
  .slot--break {
    display: none;
  }

  .break-span {
    z-index: 1;
    grid-row: 1;
    grid-column: var(--col) / span var(--len);
    align-self: start;
    margin: 190px 8px 0;
    list-style: none;
    pointer-events: none;
  }

  .break-banner {
    display: flex;
    gap: 24px;
    align-items: center;
    justify-content: center;
    padding: 20px 34px 20px 30px;
    border: 2.5px dashed #cc7a22;
    border-radius: 20px;
    background: #fbe4b8;
    color: #7a3b12;
    rotate: 0.8deg;
  }

  .break-banner__doodle {
    flex: none;
    width: 45px;
    height: 45px;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    rotate: -6deg;
  }

  .break-banner__text h3 {
    font-family: var(--font-hand);
    font-size: 34px;
    font-weight: var(--weight-bold);
    line-height: 1.1;
  }

  .break-banner__text p {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
  }

  .day.is-today .day__pill {
    background: var(--color-coral);
    color: #fff;
  }

  .day.is-today .day__badge {
    display: block;
  }

  .day.is-today .day__column {
    border-color: var(--color-coral);
    background: #ffe8e4;
  }

  .day.is-today .day__kanji {
    color: var(--color-coral);
  }

  .day.is-past .day__pill,
  .day.is-past .day__column {
    opacity: 0.55;
  }

  /* ---------- Coming up ---------- */
  .coming {
    padding: 28px 30px 38px;
    border: 1.5px solid var(--color-kanji);
    border-radius: 28px;
    background: var(--panel);
    --ticket-backdrop: var(--panel);
  }

  .coming h2 {
    color: var(--color-maroon);
    font-size: 24px;
    font-weight: var(--weight-semibold);
  }

  .coming__list {
    display: flex;
    flex-direction: column;
    gap: 26px;
    align-items: center;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- Phone: a loose timeline with a loopy dotted line ---------- */
  @media (max-width: 768px) {
    .forecast {
      padding: 28px 0 56px;
    }

    .forecast__inner {
      gap: 24px;
      width: auto;
      padding-inline: 16px;
    }

    .board {
      padding: 16px 16px 22px;
      border-radius: 30px;
    }

    .board__blossom--top {
      top: -18px;
      left: -16px;
      width: 44px;
    }

    .board__blossom--bottom {
      display: none;
    }

    .board__head {
      gap: 10px;
      margin-bottom: 18px;
    }

    .tile {
      width: 46px;
      height: 46px;
      border-radius: 14px;
    }

    .board__title {
      gap: 3px;
      padding: 10px 8px 9px;
      border-radius: 18px;
    }

    .board__title h1 {
      font-size: 34px;
      letter-spacing: 1px;
    }

    .board__divider {
      width: 170px;
    }

    .board__divider :global(img) {
      width: 16px;
    }

    /* Centered, with the dates on a line of their own under the heading (in both views, so nothing changes height). */
    .board__range {
      font-size: 11px;
      text-align: center;
    }

    .range-dot {
      display: none;
    }

    .range-dates {
      display: block;
    }

    .week[data-enter] {
      --from: 12px;
    }

    .week[data-enter="prev"] {
      --from: -12px;
    }

    .week[data-leave] {
      --to: -12px;
    }

    .week[data-leave="prev"] {
      --to: 12px;
    }

    .board__toggle {
      margin-top: 4px;
    }

    .board__toggle button {
      padding: 5px 12px;
      font-size: 11px;
    }

    .board__toggle button span {
      display: none;
    }

    /* The phone's title line is narrow, so the note is the shorter one. */
    .board.is-preview .heading--next {
      display: none;
    }

    .board.is-preview .heading--next-short {
