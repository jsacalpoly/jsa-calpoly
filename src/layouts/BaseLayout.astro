---
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Skip the gap above the footer, for pages that end in a full-width colored band. */
  flushFooter?: boolean;
  /** Pages with their own phone layout opt in, so phones are no longer shrunk to fit the 1440px design. */
  responsive?: boolean;
  /** Standalone pages (like /links) leave out the header and footer. */
  bare?: boolean;
  /** Keep the page out of search results. */
  noindex?: boolean;
}

const {
  title = "Cal Poly Japanese Student Association",
  description = "The Japanese Student Association at Cal Poly San Luis Obispo. Sharing and celebrating Japanese culture, and building a JSA family on campus.",
  flushFooter = false,
  responsive = false,
  bare = false,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class:list={{ responsive }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      document.documentElement.classList.add("js");

      // The layout is built for a 1440px-wide window. On narrower screens (laptops, Windows display
      // scaling) shrink the whole page to fit instead of making visitors zoom out or scroll sideways.
      (function () {
        const root = document.documentElement;
        function fit() {
          root.style.zoom = "";
          // Pages with a phone layout (class "responsive") use real phone widths, so no shrinking there.
          if (root.classList.contains("responsive") && root.clientWidth <= 768) {
            root.style.setProperty("--viewport-h", window.innerHeight + "px");
            return;
          }
          const scale = Math.min(1, root.clientWidth / 1440);
          if (scale < 1) root.style.zoom = String(scale);
          // Window height in the zoomed page's pixels, so the hero can still fill the screen.
          root.style.setProperty("--viewport-h", window.innerHeight / scale + "px");
        }
        fit();
        window.addEventListener("resize", fit);
      })();
    </script>

    <!-- Fonts: change these families together with the variables in src/styles/tokens.css -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Aboreto&family=Caveat:wght@400;700&family=Courier+Prime:wght@400;700&family=Inknut+Antiqua&family=Jost:ital,wght@0,300;1,300&family=Krona+One&family=Montserrat:wght@800&family=Noto+Sans+JP:wght@400;700&family=Noto+Serif+JP:wght@500;700&family=Nunito+Sans:wght@300&family=Poppins:wght@200;300;400;500;600;700&display=swap"
    />
  </head>
  <body>
    {!bare && <Header />}
    <main class:list={{ "flush-footer": flushFooter || bare }}>
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>

<script>
  // Fade elements marked with data-reveal in the first time they scroll into view.
  const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      }
    },
    { threshold: 0.15 },
  );
  targets.forEach((target) => observer.observe(target));
</script>

<style>
  main {
    padding-bottom: var(--footer-gap);
  }

  main.flush-footer {
    padding-bottom: 0;
  }
</style>
