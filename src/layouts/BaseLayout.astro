---
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cal Poly Japanese Student Association",
  description = "The Japanese Student Association at Cal Poly San Luis Obispo: culture, community, and chaos.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Fonts: change these families together with the variables in src/styles/tokens.css -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Aboreto&family=Courier+Prime&family=Inknut+Antiqua&family=Jost:ital,wght@0,300;1,300&family=Krona+One&family=Noto+Sans+JP:wght@400;700&family=Nunito+Sans:wght@300&family=Poppins:wght@200;300;400;600;700&display=swap"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
