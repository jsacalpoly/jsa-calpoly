---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  /** Card background, a CSS color or token like var(--color-coral). */
  color: string;
  /** Card height in px (Figma cards differ by a few pixels). */
  height?: number;
  /** Use the Japanese font for the title (GenKey). */
  jpTitle?: boolean;
}

const { title, description, image, color, height = 579, jpTitle = false } = Astro.props;
---

<article class="project-card" style={`--card-color: ${color}; --card-height: ${height}px;`}>
  <div class="project-card__photo">
    <Image src={image} alt="" width={574} height={574} />
  </div>
  <h3 class:list={["project-card__title", { "project-card__title--jp": jpTitle }]}>{title}</h3>
  <p class="project-card__description">{description}</p>
</article>

<style>
  .project-card {
    width: 309px;
    height: var(--card-height);
    padding: 13px 0 0 10px;
    border-radius: 12px;
    background: var(--card-color);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  .project-card__photo {
    width: 287px;
    height: 287px;
    border-radius: 12px;
    background: var(--color-white);
    box-shadow: var(--shadow-frame);
    overflow: hidden;
  }

  .project-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__title {
    /* Card is 309px wide but the photo is inset 10px left, so re-center on the card. */
    margin: 21px 0 0 -10px;
    width: 309px;
    font-size: 22px;
    font-weight: var(--weight-semibold);
    line-height: normal;
    color: #000;
  }

  .project-card__title--jp {
    font-family: var(--font-jp);
    font-weight: var(--weight-regular);
  }

  .project-card__description {
    margin: 14px 0 0 -10px;
    width: 309px;
    padding-inline: 39.5px;
    font-size: 15px;
    font-weight: var(--weight-extralight);
    line-height: 24px;
    color: #000;
  }
</style>
