---
import type { ImageMetadata } from "astro";
import TapedPhoto from "./TapedPhoto.astro";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  /** Paper color, a CSS color or token like var(--color-coral). */
  color: string;
  /** Use the Japanese font for the title (GenKey). */
  jpTitle?: boolean;
  /** Rotation of the taped photo, in degrees. */
  photoTilt?: number;
  /** Rotation of the paper itself, in degrees. */
  paperTilt?: number;
  /** Pushes this card down so the row is not a straight line, in px. */
  offset?: number;
  /** Which part of the photo stays in view when it is cropped, e.g. "50% 0%" to keep the top. */
  focus?: string;
  /** Where "Learn more" goes. The link is left out until the project has a page. */
  href?: string;
}

const {
  title,
  description,
  image,
  color,
  jpTitle = false,
  photoTilt = 0,
  paperTilt = 0,
  offset = 0,
  focus,
  href,
} = Astro.props;
---

<div class="project" style={`--offset: ${offset}px;`}>
  <article class="paper" style={`--paper-color: ${color}; --paper-tilt: ${paperTilt}deg;`}>
    <!-- The photo is taped on and sticks out over the top edge of the paper -->
    <div class="paper__photo">
      <TapedPhoto src={image} alt="" width={298} height={200} tilt={photoTilt} focus={focus} sizes="298px" />
    </div>
    <h3 class:list={["paper__title", { "paper__title--jp": jpTitle }]}>{title}</h3>
    <p class="paper__description">{description}</p>
    {href && (
      <a class="paper__link" href={href}>
        Learn more →
      </a>
    )}
  </article>
</div>

<style>
  .project {
    flex: none;
    padding-top: var(--offset);
  }

  .paper {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 400px;
    padding: 252px 30px 34px;
    border-radius: 6px;
    background: var(--paper-color);
    box-shadow: 0 5px 12px rgba(0, 0, 0, 0.25);
    color: var(--color-ink);
    rotate: var(--paper-tilt);
  }

  .paper__photo {
    position: absolute;
    top: -44px;
    left: 35px;
  }

  .paper__title {
    font-size: 30px;
    font-weight: var(--weight-semibold);
    line-height: 1.15;
  }

  .paper__title--jp {
    font-family: var(--font-jp);
    font-weight: var(--weight-bold);
  }

  .paper__description {
    font-size: 15px;
    font-weight: var(--weight-light);
    line-height: 1.55;
  }

  .paper__link {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: var(--weight-bold);
  }

  .paper__link:hover,
  .paper__link:focus-visible {
    text-decoration: underline;
  }
</style>
