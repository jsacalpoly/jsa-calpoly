---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  /** Card background, a CSS color or token like var(--color-coral). */
  color: string;
  /** Use the Japanese font for the title (GenKey). */
  jpTitle?: boolean;
}

const { title, description, image, color, jpTitle = false } = Astro.props;
---

<article class="project-card" style={`--card-color: ${color};`}>
  <div class="project-card__photo">
    <Image src={image} alt="" widths={[480, 960, 1440]} sizes="(min-width: 1760px) 480px, 30vw" quality={85} />
  </div>
  <h3 class:list={["project-card__title", { "project-card__title--jp": jpTitle }]}>{title}</h3>
  <p class="project-card__description">{description}</p>
</article>

<style>
  /* Fluid card: the row stretches every card to the tallest one. */
  .project-card {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 13px 10px 28px;
    border-radius: 12px;
    background: var(--card-color);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  .project-card__photo {
    height: 287px;
    border-radius: 12px;
    background: var(--color-white);
    box-shadow: var(--shadow-frame);
    overflow: hidden;
  }

  .project-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__title {
    font-size: 26px;
    font-weight: var(--weight-semibold);
    line-height: 33.8px;
    color: #000;
  }

  .project-card__title--jp {
    font-family: var(--font-jp);
    font-weight: var(--weight-regular);
  }

  .project-card__description {
    font-size: 18px;
    font-weight: var(--weight-extralight);
    line-height: 27px;
    color: #000;
  }
</style>
