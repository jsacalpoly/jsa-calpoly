---
import type { ImageMetadata } from "astro";
import TapedPhoto from "./TapedPhoto.astro";

interface Props {
  /** The program's slug; the button opens its popup. */
  slug: string;
  title: string;
  /** A second title in Japanese, shown beside the title. */
  subtitleJp?: string;
  eyebrow?: string;
  /** A handwritten line under the text. */
  note?: string;
  description: string;
  image: ImageMetadata;
  focus?: string;
  tilt?: number;
}

const { slug, title, subtitleJp, eyebrow, note, description, image, focus, tilt = -2.5 } = Astro.props;
---

<section class="feature">
  <div class="feature__card">
    <div class="feature__photo">
      <TapedPhoto
        src={image}
        alt="Senpai and kouhai posing together outside"
        width={400}
        height={332}
        tilt={tilt}
        focus={focus}
        sizes="(max-width: 768px) 246px, 400px"
      />
    </div>
    <div class="feature__copy">
      {eyebrow && <p class="feature__eyebrow">{eyebrow}</p>}
      <h2 class="feature__title">
        {title}
        {subtitleJp && (
          <span class="feature__jp" lang="ja">
            {subtitleJp}
          </span>
        )}
      </h2>
      <p class="feature__text">{description}</p>
      {note && <p class="feature__note">{note}</p>}
      <a class="feature__button" href={`#${slug}`} data-project-open={slug}>
        Learn about the program →
      </a>
    </div>
  </div>
</section>

<style>
  /* A full-width red band with a cream card on it. The photo hangs over the card's top-left corner. */
  .feature {
    padding: 120px 0 100px;
    background: var(--color-red);
  }

  .feature__card {
    position: relative;
    display: flex;
    align-items: center;
    width: 1060px;
    margin-inline: auto;
    padding: 60px 60px 60px 530px;
    border-radius: 6px;
    background: var(--color-peach);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.3);
    rotate: -0.4deg;
  }

  .feature__photo {
    position: absolute;
    top: -52px;
    left: 34px;
  }

  .feature__photo :global(.taped) {
    padding: 20px 20px 48px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  }

  .feature__photo :global(.taped__tape) {
    width: 120px;
    height: 32px;
  }

  .feature__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    min-width: 0;
  }

  .feature__eyebrow {
    color: var(--color-red);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .feature__title {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 14px;
    color: var(--color-ink);
    font-size: 42px;
    font-weight: var(--weight-semibold);
    line-height: 1.2;
  }

  .feature__jp {
    font-family: var(--font-jp);
    font-size: 24px;
    font-weight: var(--weight-bold);
  }

  .feature__text {
    max-width: 440px;
    color: var(--color-text-soft);
    font-size: 18px;
    font-weight: var(--weight-light);
    line-height: 28px;
  }

  .feature__note {
    color: var(--color-red);
    font-family: var(--font-hand);
    font-size: 32px;
    font-weight: var(--weight-bold);
    line-height: 1.1;
    rotate: -1.5deg;
  }

  /* The same coral pill as the home page button. */
  .feature__button {
    display: inline-flex;
    align-items: center;
    padding: 15px 32px;
    border-radius: 999px;
    background: var(--color-coral);
    color: var(--color-white);
    font-family: var(--font-jp);
    font-size: 15px;
    font-weight: var(--weight-bold);
    transition: background-color 0.4s ease;
  }

  .feature__button:hover,
  .feature__button:focus-visible {
    background: var(--color-red);
  }

  /* Phone: the photo sits on top of the text inside a narrower card. */
  @media (max-width: 768px) {
    .feature {
      padding: 64px 24px;
    }

    .feature__card {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      width: auto;
      padding: 28px 24px 30px;
    }

    .feature__photo {
      position: static;
      align-self: center;
    }

    .feature__photo :global(.taped) {
      --photo-w: 246px !important;
      --photo-h: 186px !important;
      padding: 12px 12px 28px;
    }

    .feature__photo :global(.taped__tape) {
      top: -10px;
      width: 72px;
      height: 24px;
    }

    .feature__copy {
      align-items: stretch;
      gap: 14px;
    }

    .feature__eyebrow {
      font-size: 12px;
    }

    .feature__title {
      font-size: 34px;
    }

    .feature__jp {
      font-size: 20px;
    }

    .feature__text {
      max-width: none;
      font-size: 15px;
      line-height: 23px;
    }

    .feature__note {
      align-self: flex-start;
      font-size: 28px;
    }

    .feature__button {
      justify-content: center;
      padding: 14px 24px;
    }
  }
</style>
