---
interface Props {
  title: string;
  /** Small line above the title, e.g. "Saturday" or "Save the date". */
  kicker: string;
  /** Stub: "DEC" over "12", or "DATE" over "TBD". */
  month: string;
  day: string;
  /** "6:00 PM  ·  Chumash Auditorium". Left out while nothing is decided. */
  details?: string;
  /** Which side the tear-off stub is on. The tickets alternate. */
  side: "left" | "right";
  look: "maroon" | "kraft" | "coral";
  tilt: number;
  shift: number;
}

const { title, kicker, month, day, details, side, look, tilt, shift } = Astro.props;
---

<!-- A tear-off ticket for one of the big events. -->
<li class="ticket" data-side={side} data-look={look} style={`--tilt: ${tilt}deg; --shift: ${shift}px`} data-reveal="up">
  <div class="ticket__main">
    <p class="ticket__kicker">{kicker}</p>
    <h3 class="ticket__title">{title}</h3>
    {details && <p class="ticket__details">{details}</p>}
  </div>
  <div class="ticket__stub">
    <span class="ticket__month">{month}</span>
    <span class="ticket__day" data-text={/^\d+$/.test(day) ? undefined : ""}>
      {day}
    </span>
  </div>
</li>

<style>
  .ticket {
    --paper: var(--color-maroon);
    --ink: #fff;
    --soft: #f5d796;
    --line: #e8b846;

    position: relative;
    display: flex;
    width: 620px;
    max-width: 100%;
    min-height: 124px;
    margin-left: var(--shift);
    border-radius: 14px;
    background: var(--paper);
    color: var(--ink);
    list-style: none;
    rotate: var(--tilt);
    filter: drop-shadow(0 2px 4px rgba(75, 38, 26, 0.16));
  }

  .ticket[data-side="left"] {
    flex-direction: row-reverse;
  }

  .ticket[data-look="kraft"] {
    --paper: #f4e2c0;
    --ink: #6e3c28;
    --soft: #8c6446;
    --line: #966941;
  }

  .ticket[data-look="coral"] {
    --paper: var(--color-coral);
    --soft: #ffe8e2;
    --line: #fff;
  }

  .ticket__main {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    padding: 22px 30px;
  }

  .ticket__kicker {
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .ticket__title {
    font-family: var(--font-hand);
    font-size: 38px;
    font-weight: var(--weight-bold);
    line-height: 1.05;
  }

  .ticket__details {
    margin-top: 8px;
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  .ticket__stub {
    position: relative;
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 116px;
    border-left: 1.6px dashed var(--line);
  }

  .ticket[data-side="left"] .ticket__stub {
    border-right: 1.6px dashed var(--line);
    border-left: 0;
  }

  /* The two little bites out of the ticket where the stub tears off. */
  .ticket__stub::before,
  .ticket__stub::after {
    content: "";
    position: absolute;
    left: -10.3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--ticket-backdrop, #fffcfa);
  }

  .ticket[data-side="left"] .ticket__stub::before,
  .ticket[data-side="left"] .ticket__stub::after {
    right: -10.3px;
    left: auto;
  }

  .ticket__stub::before {
    top: -9px;
  }

  .ticket__stub::after {
    bottom: -9px;
  }

  .ticket__month {
    color: var(--soft);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.22em;
  }

  .ticket__day {
    font-family: var(--font-hand);
    font-size: 58px;
    font-weight: var(--weight-bold);
    line-height: 1;
  }

  /* "TBD" is wider than a day number, so it is written smaller. */
  .ticket__day[data-text] {
    font-size: 42px;
  }

  @media (max-width: 768px) {
    .ticket {
      width: 100%;
      min-height: 112px;
      margin-left: calc(var(--shift) * 0.4);
    }

    .ticket__main {
      padding: 18px 18px 18px 22px;
    }

    .ticket__title {
      font-size: 31px;
    }

    .ticket__details {
      font-size: 11px;
    }

    .ticket__stub {
      width: 82px;
    }

    .ticket__day {
      font-size: 46px;
    }

    .ticket__day[data-text] {
      font-size: 32px;
    }
  }
</style>
