---
import { Image } from "astro:assets";
import logo from "../assets/shared/jsa-logo.png";
import chevron from "../assets/shared/select-chevron.png";
import { navLinks } from "../data/navigation";

// Which page we are on, for the phone menu's highlighted link.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href="/" aria-label="JSA home">
      <Image src={logo} alt="" width={78} height={73} densities={[1, 2, 3]} loading="eager" />
    </a>

    <a class="site-header__title" href="/">
      <span class="site-header__name">JAPANESE STUDENT ASSOCIATION</span>
      <span class="site-header__school">
        <span data-school-live aria-hidden="true">
          CAL POLY SAN LUIS OBISPO
        </span>
        <span class="site-header__sr">CAL POLY SAN LUIS OBISPO</span>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Main">
      {navLinks.map((link) => (
        <a class="site-header__link" href={link.href} style={`margin-left: ${Math.round(link.gap * 1.17)}px`}>
          {link.name}
        </a>
      ))}
    </nav>

    <div class="site-header__language">
      <select aria-label="Language">
        <option>English</option>
      </select>
      <Image class="site-header__chevron" src={chevron} alt="" width={12} height={6} />
    </div>

    <!-- Phone only: the menu button. -->
    <button
      class="site-header__menu"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-open
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<!-- Phone only: the full-width menu that drops from the top, with the page dimmed behind it. -->
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden data-menu>
  <div class="mobile-menu__panel">
    <div class="mobile-menu__bar">
      <a class="mobile-menu__logo" href="/" aria-label="JSA home">
        <Image src={logo} alt="" width={48} height={45} densities={[1, 2, 3]} />
      </a>
      <a class="mobile-menu__title" href="/">
        <span class="mobile-menu__name">JAPANESE STUDENT ASSOCIATION</span>
        <span class="mobile-menu__school">CAL POLY SLO</span>
      </a>
      <button class="mobile-menu__close" type="button" aria-label="Close menu" data-menu-close>
        <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
          <path d="M2 2 16 16M16 2 2 16"></path>
        </svg>
      </button>
    </div>
    <nav class="mobile-menu__links" aria-label="Main">
      {navLinks.map((link) => (
        <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
          {link.name}
        </a>
      ))}
    </nav>
    <div class="mobile-menu__language" role="group" aria-label="Language">
      <span class="is-active" aria-current="true">
        EN
      </span>
      <span lang="ja" aria-disabled="true">
        日本語
      </span>
    </div>
  </div>
  <button class="mobile-menu__dim" type="button" aria-label="Close menu" tabindex="-1" data-menu-close></button>
</div>

<style>
  .site-header {
    background: var(--color-white);
    height: var(--header-height);
  }

  .site-header__inner {
    width: var(--page-width);
    height: 100%;
    margin-inline: auto;
    display: flex;
    align-items: flex-start;
    padding-left: 53px; /* logo left edge, same as Figma */
  }

  .site-header__logo {
    margin-top: 9.5px;
    flex: none;
  }

  .site-header__title {
    margin: 13px 0 0 14px;
    width: 470px;
    color: var(--color-maroon);
    font-weight: var(--weight-semibold);
    line-height: 28px;
  }

  .site-header__name,
  .site-header__school {
    display: block;
  }

  .site-header__name {
    font-size: 23px;
  }

  .site-header__school {
    font-size: 17px;
  }

  /* Read by screen readers, hidden while the visible text is scrambling. */
  .site-header__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .site-header__nav {
    display: flex;
    margin: 20px 0 0 auto;
  }

  .site-header__link {
    font-size: 16px;
    font-weight: var(--weight-extralight);
    line-height: 52px;
    text-transform: uppercase;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .site-header__language {
    position: relative;
    margin: 20px 136.4px 0 15px;
    width: 132px;
    height: 52px;
  }

  .site-header__language select {
    appearance: none;
    width: 100%;
    height: 100%;
    padding: 0 0 0 12px;
    border: 1px solid var(--color-border);
    border-radius: 0;
    background: var(--color-white);
    color: #000;
    font-family: var(--font-ui);
    font-size: 18px;
    font-weight: var(--weight-light);
    cursor: pointer;
  }

  .site-header__chevron {
    position: absolute;
    right: 16px;
    top: 23px;
    pointer-events: none;
  }

  /* Phone-only pieces stay out of the desktop header. */
  .site-header__menu,
  .mobile-menu {
    display: none;
  }

  /* ---------- Phone header and menu (pages that opt in with html.responsive) ---------- */
  @media (max-width: 768px) {
    :global(html.responsive) .site-header {
      height: 64px;
    }

    :global(html.responsive) .site-header__inner {
      align-items: center;
      gap: 14px;
      width: 100%;
      padding: 0 20px;
    }

    :global(html.responsive) .site-header__logo {
      margin: 0;
    }

    :global(html.responsive) .site-header__logo :global(img) {
      width: 40px;
      height: 38px;
    }

    /* The wordmark with the school line under it (which still scrambles in from "CHAPTER"). */
    :global(html.responsive) .site-header__title {
      flex: 1;
      width: auto;
      min-width: 0;
      margin: 0;
      line-height: 1.3;
    }

    :global(html.responsive) .site-header__name {
      font-size: 12px;
    }

    :global(html.responsive) .site-header__school {
      font-size: 10px;
    }

    /* The desktop links and language select move into the menu. */
    :global(html.responsive) .site-header__nav,
    :global(html.responsive) .site-header__language {
      display: none;
    }

    /* Three bars in a 44px tap target. */
    :global(html.responsive) .site-header__menu {
      position: relative;
      display: block;
      flex: none;
      width: 44px;
      height: 44px;
      margin-right: -6px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }

    :global(html.responsive) .site-header__menu span {
      position: absolute;
      left: 10px;
      width: 24px;
      height: 2px;
      border-radius: 1px;
      background: var(--color-ink);
    }

    :global(html.responsive) .site-header__menu span:nth-child(1) {
      top: 14px;
    }

    :global(html.responsive) .site-header__menu span:nth-child(2) {
      top: 21px;
    }

    :global(html.responsive) .site-header__menu span:nth-child(3) {
      top: 28px;
    }

    :global(html.responsive) .mobile-menu:not([hidden]) {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: block;
    }

    :global(html.responsive) .mobile-menu__dim {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      padding: 0;
      border: 0;
      background: rgba(0, 0, 0, 0.4);
      animation: menu-fade 0.25s ease both;
    }

    :global(html.responsive) .mobile-menu__panel {
      position: relative;
      z-index: 1;
      border-radius: 0 0 28px 28px;
      background: var(--color-white);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.16);
      animation: menu-drop 0.3s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }

    :global(html.responsive) .mobile-menu__bar {
      display: flex;
      align-items: center;
      gap: 14px;
      height: 64px;
      padding: 0 20px;
    }

    :global(html.responsive) .mobile-menu__logo {
      display: block;
      flex: none;
    }

    :global(html.responsive) .mobile-menu__logo :global(img) {
      width: 40px;
      height: 38px;
    }

    :global(html.responsive) .mobile-menu__title {
      flex: 1;
      min-width: 0;
      color: var(--color-maroon);
      font-size: 12px;
      font-weight: var(--weight-semibold);
      line-height: 1.3;
    }

    :global(html.responsive) .mobile-menu__name,
    :global(html.responsive) .mobile-menu__school {
      display: block;
    }

    :global(html.responsive) .mobile-menu__school {
      font-size: 10px;
    }

    :global(html.responsive) .mobile-menu__close {
      display: grid;
      flex: none;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -6px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }

    :global(html.responsive) .mobile-menu__close path {
      fill: none;
      stroke: var(--color-ink);
      stroke-width: 2;
      stroke-linecap: round;
    }

    :global(html.responsive) .mobile-menu__links {
      display: flex;
      flex-direction: column;
      padding: 4px 32px 8px;
    }

    :global(html.responsive) .mobile-menu__links a {
      position: relative;
      display: flex;
      align-items: center;
      height: 56px;
      color: var(--color-ink);
      font-size: 20px;
      font-weight: var(--weight-extralight);
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    /* The page you are on: bolder, maroon, with a dot. */
    :global(html.responsive) .mobile-menu__links a[aria-current="page"] {
      color: var(--color-maroon);
      font-size: 18px;
      font-weight: var(--weight-semibold);
      letter-spacing: 0.04em;
    }

    :global(html.responsive) .mobile-menu__links a[aria-current="page"]::before {
      content: "";
      position: absolute;
      left: -14px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-maroon);
    }

    /* EN / 日本語 pill. Only English exists for now, so the Japanese side is shown but not clickable. */
    :global(html.responsive) .mobile-menu__language {
      display: flex;
      gap: 2px;
      width: 130px;
      margin: 8px 32px 28px;
      padding: 4px;
      border-radius: 22px;
      background: #f4f4f4;
    }

    :global(html.responsive) .mobile-menu__language span {
      display: grid;
      flex: 1;
      place-items: center;
      height: 36px;
      border-radius: 18px;
      color: #737373;
      font-family: var(--font-jp);
      font-size: 14px;
    }

    :global(html.responsive) .mobile-menu__language .is-active {
      background: var(--color-ink);
      color: var(--color-white);
      font-family: var(--font-body);
      font-weight: var(--weight-medium);
    }

    @keyframes menu-fade {
      from {
        opacity: 0;
      }
    }

    @keyframes menu-drop {
      from {
        opacity: 0;
        translate: 0 -12px;
      }
    }
  }

  @media (max-width: 768px) and (prefers-reduced-motion: reduce) {
    :global(html.responsive) .mobile-menu__dim,
    :global(html.responsive) .mobile-menu__panel {
      animation: none;
    }
  }
</style>

<script>
  // Phone menu: opens from the menu button, closes with the X, the dimmed area, Escape or a link.
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");

  function setMenu(open: boolean) {
    if (!menu || !openButton) return;
    menu.hidden = !open;
    openButton.setAttribute("aria-expanded", String(open));
    // Keep the page behind from scrolling while the menu is up.
    document.documentElement.style.overflow = open ? "hidden" : "";
    if (open) menu.querySelector<HTMLElement>(".mobile-menu__close")?.focus();
    else openButton.focus();
  }

  openButton?.addEventListener("click", () => setMenu(true));
  menu?.querySelectorAll("[data-menu-close]").forEach((el) => el.addEventListener("click", () => setMenu(false)));
  menu?.querySelectorAll(".mobile-menu__links a").forEach((el) => el.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu && !menu.hidden) setMenu(false);
  });
</script>

<script>
  // Only on the home page. The subtitle starts as "CHAPTER", then the letters shuffle and settle into the full name.
  const live = document.querySelector<HTMLElement>("[data-school-live]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const onHome = location.pathname === "/" || location.pathname === "/index.html";

  if (live && !reduceMotion && onHome) {
    const finalText = live.textContent ?? "";
    const startText = "CHAPTER";
    const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

    live.textContent = startText;

    document.fonts.ready.then(() => {
      // Each position gets a fixed-width cell so the shuffling letters never push the line wider.
      const style = getComputedStyle(live);
      const ctx = document.createElement("canvas").getContext("2d");
      if (!ctx) return;
      ctx.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
      const width = (char: string) => ctx.measureText(char).width;
      const letterWidths = [...letters].map((char) => ({ char, w: width(char) }));

      function run(from: string, delay: number) {
        const cells = [...finalText].map((char, i) => {
          const w = width(char);
          // Shuffle only through letters about as wide as the one that belongs here.
          const similar = letterWidths.filter((l) => Math.abs(l.w - w) < w * 0.25 + 2).map((l) => l.char);
          return { char, w, pool: similar.length ? similar : [...letters], start: from[i] ?? "" };
        });
        const spans = cells.map((cell) => {
          const el = document.createElement("span");
          el.style.cssText = `display:inline-block;width:${cell.w}px;text-align:center;white-space:pre`;
          return el;
        });

        window.setTimeout(() => {
          live!.replaceChildren(...spans);
          const begin = performance.now();
          const step = (time: number) => {
            const elapsed = time - begin;
            let done = true;
            cells.forEach((cell, i) => {
              const settled = cell.char === " " || elapsed > 500 + i * 75;
              if (settled) spans[i].textContent = cell.char;
              else {
                spans[i].textContent = cell.pool[Math.floor(Math.random() * cell.pool.length)];
                done = false;
              }
            });
            if (done) live!.textContent = finalText;
            else requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }, delay);
      }

      run(startText, 2000);
    });
  }
</script>
