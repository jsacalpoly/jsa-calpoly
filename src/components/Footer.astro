---
import { Image } from "astro:assets";
import logo from "../assets/shared/jsa-logo.png";
import instagram from "../assets/shared/social-instagram.png";
import groupme from "../assets/shared/social-groupme.png";
import tiktok from "../assets/shared/social-tiktok.png";
import linkedin from "../assets/shared/social-linkedin.png";
import { navLinks } from "../data/navigation";

const email = "jsacalpoly@gmail.com";

// Shown under the copyright. Set when the site is built, as MM-DD-YY.
const now = new Date();
const changelog = [now.getMonth() + 1, now.getDate(), now.getFullYear() % 100]
  .map((n) => String(n).padStart(2, "0"))
  .join("-");

const socials = [
  { label: "Instagram", href: "https://www.instagram.com/calpolyjsa", icon: instagram },
  { label: "GroupMe", href: "https://groupme.com/join_group/110719786/Ws1imRVH", icon: groupme },
  { label: "TikTok", href: "https://www.tiktok.com/@jsa_officialaccount", icon: tiktok },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/cpjsa/", icon: linkedin },
];

const githubHref = "https://github.com/jsacalpoly";
const changelogHref = "https://github.com/jsacalpoly/jsa-calpoly/commits/main";
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a class="site-footer__name" href="/">
        <Image src={logo} alt="" width={52} height={49} densities={[1, 2, 3]} />
        <span>JAPANESE STUDENT ASSOCIATION</span>
      </a>
      <p class="site-footer__time">
        <span class="site-footer__time-icon" data-time-icon aria-hidden="true">
          <svg
            class="icon-sun"
            viewBox="0 0 22 22"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          >
            <circle cx="11" cy="11" r="4" />
            <path d="M11 3.5v-3M11 18.5v3M3.5 11h-3M18.5 11h3M5.7 5.7 3.6 3.6M16.3 16.3l2.1 2.1M5.7 16.3l-2.1 2.1M16.3 5.7l2.1-2.1" />
          </svg>
          <svg
            class="icon-moon"
            viewBox="0 0 22 22"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          >
            <path d="M17.5 14.2A7.5 7.5 0 0 1 8.8 4.5a7.5 7.5 0 1 0 8.7 9.7Z" />
          </svg>
        </span>
        <span class="site-footer__clock" data-clock>
          <span data-clock-hour>&nbsp;</span>
          <span class="site-footer__colon">:</span>
          <span data-clock-rest></span>
        </span>
        <span>San Luis Obispo, CA</span>
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      {navLinks.map((link) => (
        <a href={link.href}>{link.name}</a>
      ))}
    </nav>

    <div class="site-footer__contact">
      <p class="site-footer__prompt">Join the family!</p>
      <a class="site-footer__email" href={`mailto:${email}`}>
        {email}
      </a>
      <ul class="site-footer__social">
        {socials.map((social) => (
          <li>
            <a href={social.href} aria-label={social.label}>
              <Image src={social.icon} alt="" width={28} height={28} />
            </a>
          </li>
        ))}
        <li>
          <a href={githubHref} aria-label="GitHub">
            <svg viewBox="0 0 16 16" width="28" height="28" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
          </a>
        </li>
      </ul>
    </div>

    <p class="site-footer__copy">© 2026 Japanese Student Association, Cal Poly SLO</p>
    <p class="site-footer__changelog">
      <a href={changelogHref} aria-label={`Changelog: ${changelog}`}>
        <span data-scramble={`Changelog: ${changelog}`} aria-hidden="true">
          Changelog: {changelog}
        </span>
      </a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-white);
    color: var(--color-muted);
  }

  /* Spans the whole screen. The top rule is part of the footer, so it is the same on every page. */
  .site-footer__inner {
    display: grid;
    grid-template-columns: 662fr 327fr 339fr;
    grid-template-areas:
      "brand nav contact"
      "copy copy copy"
      "log log log";
    margin-inline: 56px;
    padding: 44px 0 22px;
    border-top: 1px solid var(--color-divider);
  }

  .site-footer__name {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--color-maroon);
    font-size: 26px;
    font-weight: var(--weight-semibold);
    line-height: 1.2;
  }

  .site-footer__time {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    font-size: 17px;
    font-weight: var(--weight-light);
    line-height: 26px;
  }

  .site-footer__time-icon {
    display: block;
    width: 22px;
    height: 22px;
    margin-right: -2px;
  }

  .site-footer__time-icon svg {
    display: none;
    width: 100%;
    height: 100%;
  }

  .site-footer__time-icon[data-phase="day"] .icon-sun,
  .site-footer__time-icon:not([data-phase]) .icon-sun,
  .site-footer__time-icon[data-phase="night"] .icon-moon {
    display: block;
  }

  .site-footer__nav {
    grid-area: nav;
    display: grid;
    grid-template-columns: 132px auto;
    grid-template-rows: repeat(2, auto);
    grid-auto-flow: column;
    row-gap: 20px;
    align-content: start;
    justify-content: start;
  }

  .site-footer__nav a {
    font-size: 18px;
    font-weight: var(--weight-light);
    line-height: 24px;
    white-space: nowrap;
    transition: color 0.15s;
  }

  .site-footer__nav a:hover,
  .site-footer__email:hover {
    color: var(--color-ink);
  }

  .site-footer__contact {
    grid-area: contact;
  }

  .site-footer__prompt {
    font-size: 18px;
    font-weight: var(--weight-light);
    line-height: 24px;
  }

  .site-footer__email {
    display: block;
    margin-top: 8px;
    color: var(--color-ink);
    font-size: 18px;
    font-weight: var(--weight-regular);
    line-height: 24px;
  }

  .site-footer__social {
    display: flex;
    gap: 24px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
  }

  .site-footer__social img,
  .site-footer__social svg {
    display: block;
  }

  /* Muted until hovered, like the reference. */
  .site-footer__social img {
    filter: grayscale(1);
    opacity: 0.45;
    transition: opacity 0.15s;
  }

  .site-footer__social svg {
    color: var(--color-muted);
    opacity: 0.8;
    transition: opacity 0.15s;
  }

  .site-footer__social a:hover img,
  .site-footer__social a:hover svg {
    opacity: 1;
  }

  .site-footer__copy {
    grid-area: copy;
    margin-top: 60px;
    font-size: 13px;
    font-weight: var(--weight-light);
    line-height: 20px;
    text-align: center;
  }

  .site-footer__changelog {
    grid-area: log;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    line-height: 18px;
    text-align: center;
    text-transform: uppercase;
  }

  /* Hidden until the script has filled in the time, so it never flashes empty. */
  .site-footer__clock {
    visibility: hidden;
    white-space: nowrap;
  }

  .site-footer__clock[data-ready] {
    visibility: visible;
  }

  /* The colon fades out and back in, slowly. */
  @media (prefers-reduced-motion: no-preference) {
    .site-footer__colon {
      animation: colon-blink 2s ease-in-out infinite;
    }
  }

  @keyframes colon-blink {
    0%,
    45% {
      opacity: 1;
    }
    70%,
    85% {
      opacity: 0.1;
    }
    100% {
      opacity: 1;
    }
  }

  .site-footer__changelog a {
    transition: color 0.15s;
  }

  .site-footer__changelog a:hover,
  .site-footer__changelog a:focus-visible {
    color: var(--color-ink);
    text-decoration: underline;
  }
</style>

<script>
  // Cal Poly's local time, with a sun by day and a moon at night.
  const icon = document.querySelector<HTMLElement>("[data-time-icon]");
  const clock = document.querySelector<HTMLElement>("[data-clock]");
  const hourEl = document.querySelector<HTMLElement>("[data-clock-hour]");
  const restEl = document.querySelector<HTMLElement>("[data-clock-rest]");
  const zone = "America/Los_Angeles";

  function updateTime() {
    if (!icon || !clock || !hourEl || !restEl) return;
    const now = new Date();
    const parts = new Intl.DateTimeFormat("en-US", {
      hour: "numeric",
      minute: "2-digit",
      timeZone: zone,
    }).formatToParts(now);
    const get = (type: string) => parts.find((part) => part.type === type)?.value ?? "";
    hourEl.textContent = get("hour");
    restEl.textContent = `${get("minute")} ${get("dayPeriod")}`;
    clock.dataset.ready = "";
    const hour24 = Number(
      new Intl.DateTimeFormat("en-US", { hour: "numeric", hour12: false, timeZone: zone }).format(now),
    );
    icon.dataset.phase = hour24 >= 6 && hour24 < 19 ? "day" : "night";
  }

  updateTime();
  setInterval(updateTime, 30_000);

  // The changelog scrambles into place the first time it scrolls into view, and again on hover.
  const scrambleEl = document.querySelector<HTMLElement>("[data-scramble]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const pool = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  let frame = 0;

  function scramble(el: HTMLElement) {
    const finalText = el.dataset.scramble ?? "";
    const start = performance.now();
    cancelAnimationFrame(frame);
    const step = (time: number) => {
      const elapsed = time - start;
      let out = "";
      let done = true;
      for (let i = 0; i < finalText.length; i++) {
        const char = finalText[i];
        // Letters settle one by one from the left; spaces and punctuation stay put.
        if (!/[A-Za-z0-9]/.test(char) || elapsed > 350 + i * 45) out += char;
        else {
          out += pool[Math.floor(Math.random() * pool.length)];
          done = false;
        }
      }
      el.textContent = out;
      if (!done) frame = requestAnimationFrame(step);
    };
    frame = requestAnimationFrame(step);
  }

  if (scrambleEl && !reduceMotion) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        scramble(scrambleEl);
        observer.disconnect();
      },
      { threshold: 1 },
    );
    observer.observe(scrambleEl);
    scrambleEl.closest("a")?.addEventListener("mouseenter", () => scramble(scrambleEl));
  }
</script>
