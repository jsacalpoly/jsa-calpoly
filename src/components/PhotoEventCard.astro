---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  cover: ImageMetadata;
}

const { title, cover } = Astro.props;
---

<article class="photo-event-card">
  <h3 class="photo-event-card__title">{title}</h3>
  <span class="photo-event-card__rule"></span>
  <div class="photo-event-card__text"><slot /></div>
  <div class="photo-event-card__photo">
    <Image src={cover} alt={`Photos from ${title}`} width={400} height={242} />
  </div>
</article>

<style>
  .photo-event-card {
    position: relative;
    width: 463px;
    min-height: 166px;
    padding: 84px 0 46px 18px;
    border-radius: 10px;
    background: var(--color-blush);
    box-shadow: 0 1px 3px #000;
    color: var(--color-ink);
  }

  .photo-event-card__title {
    position: absolute;
    left: 18px;
    top: 10px;
    width: 204px;
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: var(--weight-regular);
    line-height: normal;
  }

  .photo-event-card__rule {
    position: absolute;
    left: 18px;
    top: 67px;
    width: 56px;
    height: 1px;
    background: var(--color-line);
  }

  .photo-event-card__text {
    width: 177px;
    font-size: 8px;
    font-weight: var(--weight-extralight);
    line-height: 12px;
  }

  .photo-event-card__text :global(p + p) {
    margin-top: 12px;
  }

  .photo-event-card__photo {
    position: absolute;
    left: 219px;
    top: 18px;
    width: 204px;
    height: 125px;
    border: 2px solid var(--color-white);
    border-radius: 20px;
    background: var(--color-white);
    box-shadow: var(--shadow-frame);
    overflow: hidden;
  }

  .photo-event-card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 18px;
  }
</style>
