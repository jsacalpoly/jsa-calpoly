---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  cover: ImageMetadata;
  /** Optional photo album URL; the photo links to it when set. */
  album?: string;
}

const { title, cover, album } = Astro.props;
const Tag = album ? "a" : "article";
---

<Tag
  class:list={["photo-event-card", { "photo-event-card--link": album }]}
  {...(album
    ? { href: album, target: "_blank", rel: "noopener noreferrer", "aria-label": `Open the ${title} photo album` }
    : {})}
>
  <h3 class="photo-event-card__title">{title}</h3>
  <span class="photo-event-card__rule"></span>
  <div class="photo-event-card__text"><slot /></div>
  <div class="photo-event-card__photo">
    <Image src={cover} alt={`Photos from ${title}`} width={400} height={242} />
  </div>
</Tag>

<style>
  .photo-event-card {
    position: relative;
    width: 463px;
    min-height: 166px;
    padding: 84px 0 46px 18px;
    border-radius: 10px;
    background: var(--color-blush);
    box-shadow: 0 1px 3px #000;
    color: var(--color-ink);
  }

  .photo-event-card--link {
    display: block;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .photo-event-card--link:hover,
  .photo-event-card--link:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
  }

  .photo-event-card--link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .photo-event-card__title {
    position: absolute;
    left: 18px;
    top: 10px;
    width: 204px;
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: var(--weight-regular);
    line-height: normal;
  }

  .photo-event-card__rule {
    position: absolute;
    left: 18px;
    top: 67px;
    width: 56px;
    height: 1px;
    background: var(--color-line);
  }

  .photo-event-card__text {
    width: 177px;
    font-size: 8px;
    font-weight: var(--weight-extralight);
    line-height: 12px;
  }

  .photo-event-card__text :global(p + p) {
    margin-top: 12px;
  }

  .photo-event-card__photo {
    position: absolute;
    left: 219px;
    top: 18px;
    width: 204px;
    height: 125px;
    border: 2px solid var(--color-white);
    border-radius: 20px;
    background: var(--color-white);
    box-shadow: var(--shadow-frame);
    overflow: hidden;
  }

  .photo-event-card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 18px;
  }
</style>
