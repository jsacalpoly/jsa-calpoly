---
import { Image } from "astro:assets";
import pier from "../assets/home/slides/pier.jpg";
import stage from "../assets/home/slides/stage.jpg";
import lawn from "../assets/home/slides/lawn.jpg";
import sunset from "../assets/home/slides/sunset.jpg";
import sign from "../assets/home/slides/sign.jpg";

// Same five photos, in the same order, as the Wix hero slideshow.
const slides = [
  { src: pier, alt: "JSA members posing in front of a pier at the beach" },
  { src: stage, alt: "JSA members posing on a stage with a moon and stars backdrop" },
  { src: lawn, alt: "JSA members smiling together on a lawn" },
  { src: sunset, alt: "Three JSA members on the beach at sunset" },
  { src: sign, alt: "A JSA sign decorated with origami and stickers" },
];
---

<!--
  Slides glide in from the right over 0.9s with an ease-in-out curve, a new one every 5s, looping.
  The arrows fade to 60% on hover. (Wix itself is faster, 0.45s every 3.5s; this is deliberately calmer.)
-->
<div class="slideshow" data-slideshow data-interval="5000" role="region" aria-roledescription="carousel" aria-label="JSA photos">
  {
    slides.map((slide, index) => (
      <div class="slideshow__slide" data-slide hidden={index !== 0}>
        <Image src={slide.src} alt={slide.alt} width={1920} height={813} loading={index === 0 ? "eager" : "lazy"} />
      </div>
    ))
  }

  <div class="slideshow__stage">
    <button class="slideshow__arrow slideshow__arrow--prev" type="button" aria-label="Previous slide" data-prev>
      <svg viewBox="0 0 30 59" width="30" height="59" aria-hidden="true"><path d="M28 2 3 29.5 28 57" /></svg>
    </button>
    <button class="slideshow__arrow slideshow__arrow--next" type="button" aria-label="Next slide" data-next>
      <svg viewBox="0 0 30 59" width="30" height="59" aria-hidden="true"><path d="M2 2 27 29.5 2 57" /></svg>
    </button>
  </div>
</div>

<style>
  .slideshow {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .slideshow__slide {
    position: absolute;
    inset: 0;
  }

  .slideshow__slide[hidden] {
    display: none;
  }

  .slideshow__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Arrows sit on the 1440px design grid, like the rest of the hero. */
  .slideshow__stage {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: var(--page-width);
    height: 610px;
    pointer-events: none;
  }

  .slideshow__arrow {
    position: absolute;
    top: 274.2px;
    width: 30px;
    height: 58.6px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    pointer-events: auto;
    z-index: 2;
    transition: opacity 0.3s ease;
  }

  .slideshow__arrow svg {
    display: block;
    fill: none;
    stroke: #fff;
    stroke-width: 2.5;
    stroke-linecap: square;
    filter: drop-shadow(0 0 4px rgb(0 0 0 / 0.25));
  }

  .slideshow__arrow:hover,
  .slideshow__arrow:focus-visible {
    opacity: 0.6;
  }

  .slideshow__arrow--prev {
    left: 100px;
  }

  .slideshow__arrow--next {
    left: 1310px;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-slideshow]");

  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
    const interval = Number(root.dataset.interval) || 5000;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let index = 0;
    let busy = false;
    let timer: number | undefined;

    function show(next: number, direction: 1 | -1) {
      if (busy || next === index) return;
      busy = true;
      const current = slides[index];
      const incoming = slides[next];
      incoming.hidden = false;
      index = next;

      if (reduceMotion.matches) {
        current.hidden = true;
        busy = false;
        return;
      }

      // Tell the page a slide change started so the hero title can travel with it.
      document.dispatchEvent(new CustomEvent("hero:slide", { detail: { direction } }));

      const options: KeyframeAnimationOptions = { duration: 900, easing: "cubic-bezier(0.65, 0, 0.35, 1)", fill: "forwards" };
      current.animate(
        [{ transform: "translateX(0)" }, { transform: `translateX(${-100 * direction}%)` }],
        options,
      );
      incoming
        .animate([{ transform: `translateX(${100 * direction}%)` }, { transform: "translateX(0)" }], options)
        .finished.then(() => {
          current.hidden = true;
          current.getAnimations().forEach((animation) => animation.cancel());
          incoming.getAnimations().forEach((animation) => animation.cancel());
          busy = false;
        });
    }

    const go = (step: 1 | -1) => show((index + step + slides.length) % slides.length, step);

    function start() {
      stop();
      // Skip autoplay for visitors who ask for reduced motion; the arrows still work.
      if (!reduceMotion.matches) timer = window.setInterval(() => go(1), interval);
    }
    function stop() {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    }

    root.querySelector("[data-next]")?.addEventListener("click", () => {
      go(1);
      start();
    });
    root.querySelector("[data-prev]")?.addEventListener("click", () => {
      go(-1);
      start();
    });
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
    start();
  }
</script>
