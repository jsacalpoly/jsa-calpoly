---
import { Image } from "astro:assets";

import ornament from "../assets/eras/ornament-flower.png";
import blossom from "../assets/eras/blossom.png";
import iconTreasurer from "../assets/eras/icon-treasurer.png";
import iconSecretary from "../assets/eras/icon-secretary.png";
import iconEvents from "../assets/eras/icon-events.png";
import iconSports from "../assets/eras/icon-sports.png";
import iconMedia from "../assets/eras/icon-media.png";
import iconCultural from "../assets/eras/icon-cultural.png";
import iconHistorian from "../assets/eras/icon-historian.png";

type RoleIcon = "treasurer" | "secretary" | "events" | "sports" | "media" | "cultural" | "historian";

interface Props {
  year: string;
  heading: string;
  president: string;
  vicePresident: string;
  roles: { title: string; names: string; icon: RoleIcon }[];
  /** "feature" is the wide card for the last era; "recent" and "small" sit in rows of three. */
  variant: "feature" | "recent" | "small";
  /** Text in the pill on the card's top edge. Defaults to the year. */
  badge?: string;
  /** Seconds to wait before the entrance, so a row of cards appears one after another. */
  delay?: number;
}

const { year, heading, president, vicePresident, roles, variant, badge, delay = 0 } = Astro.props;

const icons = {
  treasurer: iconTreasurer,
  secretary: iconSecretary,
  events: iconEvents,
  sports: iconSports,
  media: iconMedia,
  cultural: iconCultural,
  historian: iconHistorian,
};

// Older headings include the year, e.g. "21-22 : Kanpai Jidai". Keep only the era name, if there is one.
const afterColon = heading.includes(":") ? heading.slice(heading.indexOf(":") + 1).trim() : heading.trim();
const isYearOnly = /^\d{4}\s*[-–]\s*\d{4}$/.test(afterColon);
const eraName = isYearOnly ? "" : afterColon;
const title = eraName || "JSA Board";
const yearText = year.replace("-", "–");
const featured = variant === "feature";
---

<article class:list={["era-card", `era-card--${variant}`]} data-reveal="up" style={`--reveal-delay: ${delay}s`}>
  <span class="era-card__pill">{badge ?? yearText}</span>
  {variant !== "small" && <Image class="era-card__blossom" src={blossom} alt="" width={184} height={186} />}

  <header class="era-card__head">
    <h3 class="era-card__title">{title}</h3>
    {featured && <p class="era-card__year">{yearText.replace("–", " – ")}</p>}
  </header>

  <div class="era-card__divider">
    <span class="era-card__line"></span>
    <Image class="era-card__flower" src={ornament} alt="" width={34} height={40} />
    <span class="era-card__line"></span>
  </div>

  <div class="era-card__officers">
    <div class="era-card__person">
      <p class="era-card__label">President</p>
      <p class="era-card__name">{president}</p>
    </div>
    <span class="era-card__rule"></span>
    <div class="era-card__person">
      <p class="era-card__label">Vice President</p>
      <p class="era-card__name">{vicePresident}</p>
    </div>
  </div>

  <ul class="era-card__roles">
    {roles.map((role) => (
      <li class="era-role">
        <span class="era-role__chip">
          <Image class="era-role__icon" src={icons[role.icon]} alt="" />
        </span>
        <div class="era-role__text">
          <p class="era-role__title">{role.title}</p>
          <p class="era-role__names">{role.names}</p>
        </div>
      </li>
    ))}
  </ul>
</article>

<style>
  .era-card {
    --border: #fbd0cc;
    --chip: 36px;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 44px 28px 32px;
    border: 1.5px solid var(--border);
    border-radius: 24px;
    background: var(--color-white);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    color: var(--color-ink);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  /* ---------- Year pill straddling the top edge ---------- */
  .era-card__pill {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% -50%;
    padding: 6px 16px;
    border-radius: 999px;
    background: var(--color-coral);
    box-shadow: 0 4px 10px rgba(237, 69, 69, 0.3);
    color: var(--color-white);
    font-size: 12px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    line-height: normal;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .era-card__blossom {
    position: absolute;
    top: -40px;
    right: -26px;
    width: 78px;
    height: auto;
    rotate: -18deg;
    pointer-events: none;
    transition:
      rotate 0.35s ease,
      scale 0.35s ease;
  }

  /* ---------- Head ---------- */
  .era-card__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    text-align: center;
  }

  .era-card__title {
    font-size: 20px;
    font-weight: var(--weight-semibold);
    line-height: 1.15;
  }

  .era-card__year {
    color: var(--color-text-muted);
    font-size: 13px;
    font-weight: var(--weight-medium);
    letter-spacing: 0.3em;
  }

  .era-card__divider {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .era-card__line {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .era-card__flower {
    width: 17px;
    height: auto;
  }

  /* ---------- Officers ---------- */
  .era-card__officers {
    display: flex;
    gap: 10px;
    width: 100%;
    padding: 12px 12px 12px 14px;
    border-radius: 16px;
    background: var(--color-peach);
  }

  .era-card__person {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .era-card__rule {
    flex: none;
    width: 1px;
    background: var(--border);
  }

  .era-card__label {
    color: var(--color-text-muted);
    font-size: 9.5px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .era-card__name {
    font-size: 13px;
    font-weight: var(--weight-medium);
    line-height: 1.25;
  }

  /* ---------- Roles ---------- */
  .era-card__roles {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .era-role {
    display: flex;
    gap: 12px;
  }

  .era-role__chip {
    display: grid;
    flex: none;
    place-items: center;
    width: var(--chip);
    height: var(--chip);
    border-radius: 50%;
    background: #ffeeeb;
  }

  .era-role__icon {
    width: 52%;
    height: 52%;
    object-fit: contain;
  }

  .era-role__text {
    min-width: 0;
    padding-top: 1px;
  }

  .era-role__title {
    font-size: 11.5px;
    font-weight: var(--weight-semibold);
    line-height: 1.4;
  }

  .era-role__names {
    color: var(--color-text-soft);
    font-size: 12px;
    font-weight: var(--weight-light);
    line-height: 1.4;
  }

  /* ---------- Hover: lift, coral border and glow, blossom turns ---------- */
  .era-card:hover {
    transform: translateY(-12px);
    border-color: var(--color-coral);
    box-shadow: 0 18px 40px -6px rgba(237, 69, 69, 0.24);
  }

  .era-card:hover .era-card__blossom {
    rotate: -10deg;
    scale: 1.18;
  }

  @media (prefers-reduced-motion: reduce) {
    .era-card,
    .era-card__blossom {
      transition: none;
    }
  }

  /* ---------- Recent: three across, a little roomier ---------- */
  .era-card--recent {
    --chip: 36px;
    padding: 44px 28px 32px;
  }

  .era-card--recent .era-card__title {
    font-size: 26px;
  }

  .era-card--recent .era-card__officers {
    padding: 14px 12px 14px 16px;
  }

  .era-card--recent .era-card__label {
    font-size: 10px;
  }

  .era-card--recent .era-card__name {
    font-size: 15px;
  }

  .era-card--recent .era-card__roles {
    gap: 14px;
  }

  .era-card--recent .era-role__title {
    font-size: 12.5px;
  }

  .era-card--recent .era-role__names {
    font-size: 13px;
  }

  /* ---------- Small: the archive ---------- */
  .era-card--small {
    --chip: 30px;
    gap: 14px;
    padding: 38px 22px 24px;
  }

  /* ---------- Feature: the last era ---------- */
  .era-card--feature {
    --chip: 40px;
    gap: 26px;
    padding: 60px 56px 48px;
    border-color: var(--color-coral);
    border-radius: 22px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.06);
  }

  /* Thin inner keyline, like a certificate. */
  .era-card--feature::before {
    content: "";
    position: absolute;
    inset: 9px;
    border: 1px solid var(--border);
    border-radius: 15px;
    pointer-events: none;
  }

  .era-card--feature:hover {
    transform: none;
    box-shadow: 0 14px 34px -8px rgba(237, 69, 69, 0.2);
  }

  .era-card--feature .era-card__blossom {
    top: -44px;
    right: -28px;
    width: 92px;
    rotate: -16deg;
  }

  .era-card--feature .era-card__head {
    gap: 8px;
  }

  .era-card--feature .era-card__title {
    color: var(--color-coral);
    font-family: var(--font-serif);
    font-size: 46px;
    font-weight: var(--weight-regular);
    line-height: 1.15;
  }

  .era-card--feature .era-card__divider {
    width: 340px;
    gap: 12px;
  }

  .era-card--feature .era-card__flower {
    width: 19px;
  }

  .era-card--feature .era-card__officers {
    justify-content: center;
    align-items: center;
    gap: 44px;
    width: auto;
    padding: 0;
    background: none;
  }

  .era-card--feature .era-card__person {
    flex: none;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  .era-card--feature .era-card__rule {
    align-self: stretch;
  }

  .era-card--feature .era-card__label {
    color: var(--color-ink);
    font-size: 10.5px;
    letter-spacing: 0.18em;
  }

  .era-card--feature .era-card__name {
    color: var(--color-coral);
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: var(--weight-regular);
  }

  .era-card--feature .era-card__roles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px 36px;
  }

  .era-card--feature .era-role {
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  .era-card--feature .era-role__title {
    font-size: 13px;
  }

  .era-card--feature .era-role__names {
    font-size: 13.5px;
  }
</style>
