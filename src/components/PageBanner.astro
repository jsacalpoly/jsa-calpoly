---
import { Image } from "astro:assets";
import blossomsLeft from "../assets/board/blossoms-left.png";
import blossomsRight from "../assets/board/blossoms-right.png";
import headerFlower from "../assets/eras/header-flower.png";

interface Props {
  /** The big serif title. */
  title: string;
  /** One short line under the title. */
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<!-- Same banner as the Eras page: a pale band with blossom branches at the sides and a flower on the rule. -->
<section class="banner">
  <div class="banner__stage">
    <div class="banner__blossoms-right">
      <Image src={blossomsRight} alt="" width={458} height={305} />
    </div>
    <Image class="banner__blossoms-left" src={blossomsLeft} alt="" width={238} height={212} />

    <h1 class="banner__title" data-reveal>
      {title}
    </h1>
    <p class="banner__subtitle">{subtitle}</p>

    <span class="banner__rule banner__rule--left" data-reveal="line" style="--reveal-delay: 0.15s"></span>
    <Image
      class="banner__flower"
      src={headerFlower}
      alt=""
      width={45}
      height={45}
      data-reveal
      style="--reveal-delay: 0.1s"
    />
    <span class="banner__rule banner__rule--right" data-reveal="line" style="--reveal-delay: 0.15s"></span>
  </div>
</section>

<!-- Phone banner: the same stack, centered -->
<section class="banner-m">
  <Image class="banner-m__branch banner-m__branch--right" src={blossomsRight} alt="" width={458} height={305} />
  <Image class="banner-m__branch banner-m__branch--left" src={blossomsLeft} alt="" width={238} height={212} />
  <p class="banner-m__title" data-reveal>
    {title}
  </p>
  <p class="banner-m__subtitle">{subtitle}</p>
  <div class="banner-m__flower-row">
    <span class="banner-m__rule" data-reveal="line" style="--reveal-delay: 0.15s"></span>
    <Image
      class="banner-m__flower"
      src={headerFlower}
      alt=""
      width={45}
      height={45}
      data-reveal
      style="--reveal-delay: 0.1s"
    />
    <span class="banner-m__rule" data-reveal="line" style="--reveal-delay: 0.15s"></span>
  </div>
</section>

<style>
  .banner {
    position: relative;
    z-index: 1;
    height: 178px;
    background: var(--color-off-white);
  }

  .banner__stage {
    position: relative;
    width: var(--page-width);
    height: 100%;
    margin-inline: auto;
  }

  /* The right blossoms start 37px above the banner, behind the header. Show only the part below it. */
  .banner__blossoms-right {
    position: absolute;
    left: 838px;
    top: 0;
    width: 458px;
    height: 268px;
    overflow: hidden;
    pointer-events: none;
  }

  .banner__blossoms-right :global(img) {
    width: 458px;
    height: 305px;
    margin-top: -37px;
  }

  .banner__blossoms-left {
    position: absolute;
    left: 138px;
    top: 0;
    width: 238px;
    height: 212px;
    pointer-events: none;
  }

  .banner__title,
  .banner__subtitle {
    position: absolute;
    left: 0;
    right: 0;
    white-space: nowrap;
    text-align: center;
  }

  .banner__title {
    top: 44px;
    color: var(--color-salmon);
    font-family: var(--font-serif);
    font-size: 43px;
    font-weight: var(--weight-regular);
    line-height: 43px;
  }

  .banner__subtitle {
    top: 93px;
    font-size: 20px;
    font-weight: var(--weight-extralight);
    line-height: 28px;
  }

  .banner__rule {
    position: absolute;
    top: 151px;
    width: 405px;
    height: 1px;
    background: var(--color-line);
  }

  .banner__rule--left {
    left: 230px;
  }

  .banner__rule--right {
    left: 790px;
  }

  .banner__flower {
    position: absolute;
    left: 698px;
    top: 129px;
    width: 45px;
    height: 45px;
  }

  .banner-m {
    display: none;
  }

  @media (max-width: 768px) {
    .banner {
      display: none;
    }

    .banner-m {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: 24px 24px 14px;
      overflow: hidden;
      background: var(--color-off-white);
      text-align: center;
    }

    .banner-m > * {
      position: relative;
    }

    .banner-m > :global(.banner-m__branch) {
      position: absolute;
      height: auto;
      pointer-events: none;
    }

    .banner-m > :global(.banner-m__branch--right) {
      top: -14px;
      right: -10px;
      width: 150px;
    }

    .banner-m > :global(.banner-m__branch--left) {
      bottom: 9px;
      left: -6px;
      width: 98px;
    }

    .banner-m__title {
      color: var(--color-salmon);
      font-family: var(--font-serif);
      font-size: 21px;
      font-weight: var(--weight-regular);
      line-height: 32px;
    }

    .banner-m__subtitle {
      font-size: 15px;
      font-weight: var(--weight-extralight);
      line-height: 22px;
    }

    .banner-m__flower-row {
      display: flex;
      gap: 12px;
      align-items: center;
      width: 100%;
      padding-top: 10px;
    }

    .banner-m__rule {
      flex: 1;
      height: 1px;
      background: var(--color-line);
    }

    .banner-m__flower-row > :global(.banner-m__flower) {
      flex: none;
      width: 34px;
      height: 34px;
    }
  }
</style>
